{{define "admin_nav"}}
<header class="admin-topbar">
  <div class="admin-topbar-inner">
    <a class="admin-topbar-brand" href="/admin" aria-label="管理台总览">
      <span class="admin-topbar-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <path d="M12 3l7 3v5.2c0 4.2-2.8 7.7-7 9.6-4.2-1.9-7-5.4-7-9.6V6l7-3z"></path>
          <path d="M9.2 11.8l1.9 1.9 3.7-3.9"></path>
        </svg>
      </span>
      <span class="admin-topbar-name">管理台</span>
    </a>
    {{if ne .ActiveNav "admin"}}
    <span class="admin-topbar-divider" aria-hidden="true"></span>
    <span class="admin-topbar-title">{{.Title}}</span>
    <a class="admin-topbar-back" href="/admin">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M15 5l-7 7 7 7"></path>
      </svg>
      <span>返回总览</span>
    </a>
    {{else}}
    <span class="admin-topbar-user">{{if .User}}{{.User.Name}}{{else}}管理员{{end}}</span>
    {{end}}
  </div>
</header>
{{end}}
