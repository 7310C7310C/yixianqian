{{define "register_field"}}
{{$field := .}}
<div class="register-field" id="field_{{.Name}}"{{if .HasShowWhen}} data-show-when-field="{{.ShowWhenField}}" data-show-when-option="{{.ShowWhenOption}}" hidden{{end}}>
  {{if eq .Type "multi"}}
  <fieldset class="register-multi">
    <legend><span data-register-text="field.{{.Name}}.label"></span>{{if .Required}} <span class="req" aria-hidden="true">*</span>{{end}}</legend>
    {{if .Hint}}<p class="hint" data-register-text="field.{{.Name}}.hint"></p>{{end}}
    <div class="register-chips">
      {{range $i, $option := .Options}}
      <label class="chip">
        <input type="checkbox" name="{{$field.Name}}" data-register-option="{{$field.Name}}.{{$i}}"{{if $option.Selected}} checked{{end}}>
        <span data-register-option-text="{{$field.Name}}.{{$i}}"></span>
      </label>
      {{end}}
    </div>
  </fieldset>
  {{else if eq .Type "checkbox"}}
  {{if eq .Name "angel_ack"}}
  <div class="register-angel-option">
    <label class="register-check">
      <input type="checkbox" name="{{.Name}}" data-register-option="{{.Name}}.0"{{if .Checked}} checked{{end}}{{if .Required}} required{{end}}>
      <span data-register-text="field.{{.Name}}.label"></span>{{if .Required}} <span class="req" aria-hidden="true">*</span>{{end}}
    </label>
    {{if .ShowQR}}
    <div class="register-angel-qr">
      <img src="/angel-qr?v={{.QRVersion}}" alt="" width="220" height="299" loading="lazy" data-angel-qr-image>
      <p class="hint" data-register-text="field.angel_ack.qrHint"></p>
      <p class="hint register-angel-press" data-angel-press-status hidden tabindex="-1"></p>
      <button type="button" class="register-angel-fallback" data-angel-fallback hidden>
        <span data-register-text="field.angel_ack.pressFallback"></span>
      </button>
    </div>
    {{end}}
    {{if .Hint}}<p class="hint" data-register-text="field.{{.Name}}.hint"></p>{{end}}
  </div>
  {{else}}
  <label class="register-check">
    <input type="checkbox" name="{{.Name}}" data-register-option="{{.Name}}.0"{{if .Checked}} checked{{end}}{{if .Required}} required{{end}}>
    <span data-register-text="field.{{.Name}}.label"></span>{{if .Required}} <span class="req" aria-hidden="true">*</span>{{end}}
  </label>
  {{if .Hint}}<p class="hint" data-register-text="field.{{.Name}}.hint"></p>{{end}}
  {{end}}
  {{else if eq .Type "select"}}
  <label for="f_{{.Name}}"><span data-register-text="field.{{.Name}}.label"></span>{{if .Required}} <span class="req" aria-hidden="true">*</span>{{end}}</label>
  <select id="f_{{.Name}}" name="{{.Name}}"{{if .Required}} required{{end}}>
    <option value="" data-register-text="{{if .Required}}select.required{{else}}select.optional{{end}}"></option>
    {{range $i, $option := .Options}}
    <option data-register-option="{{$field.Name}}.{{$i}}"{{if $option.Selected}} selected{{end}}></option>
    {{end}}
  </select>
  {{if .Hint}}<p class="hint" data-register-text="field.{{.Name}}.hint"></p>{{end}}
  {{else if eq .Type "region"}}
  <label><span data-register-text="field.{{.Name}}.label"></span>{{if .Required}} <span class="req" aria-hidden="true">*</span>{{end}}</label>
  <div class="register-region" data-region-field="{{.Name}}" data-region-level="{{.RegionLevel}}">
    <select data-region-province data-register-aria="region.province"></select>
    <select data-region-city data-register-aria="region.city"></select>
    {{if eq .RegionLevel "cd"}}<select data-region-area data-register-aria="region.area"></select>{{end}}
  </div>
  <input type="hidden" name="{{.Name}}_province" data-region-code="province" value="{{.ProvinceCode}}">
  <input type="hidden" name="{{.Name}}_city" data-region-code="city" value="{{.CityCode}}">
  <input type="hidden" name="{{.Name}}_area" data-region-code="area" value="{{.AreaCode}}">
  <p class="hint register-region-status" data-region-status hidden tabindex="-1"></p>
  {{if .Hint}}<p class="hint" data-register-text="field.{{.Name}}.hint"></p>{{end}}
  {{else if eq .Type "textarea"}}
  <label for="f_{{.Name}}"><span data-register-text="field.{{.Name}}.label"></span>{{if .Required}} <span class="req" aria-hidden="true">*</span>{{end}}</label>
  <textarea id="f_{{.Name}}" name="{{.Name}}" rows="{{.Rows}}"{{if .MaxLength}} maxlength="{{.MaxLength}}"{{end}}{{if .Required}} required{{end}}{{if .Placeholder}} data-register-placeholder="field.{{.Name}}.placeholder"{{end}} data-register-value="{{.Name}}"></textarea>
  {{if .Hint}}<p class="hint" data-register-text="field.{{.Name}}.hint"></p>{{end}}
  {{else if eq .Type "number"}}
  <label for="f_{{.Name}}"><span data-register-text="field.{{.Name}}.label"></span>{{if .Required}} <span class="req" aria-hidden="true">*</span>{{end}}</label>
  <input id="f_{{.Name}}" name="{{.Name}}" type="number" inputmode="numeric"
         {{if eq .Name "height_cm"}}min="100" max="250"{{end}}
         data-register-value="{{.Name}}"{{if .Placeholder}} data-register-placeholder="field.{{.Name}}.placeholder"{{end}}{{if .Required}} required{{end}}>
  {{if .Hint}}<p class="hint" data-register-text="field.{{.Name}}.hint"></p>{{end}}
  {{else if eq .Type "date"}}
  <label for="f_{{.Name}}"><span data-register-text="field.{{.Name}}.label"></span>{{if .Required}} <span class="req" aria-hidden="true">*</span>{{end}}</label>
  <input id="f_{{.Name}}" name="{{.Name}}" type="date" data-register-value="{{.Name}}"{{if .MaxDate}} max="{{.MaxDate}}"{{end}}{{if .Required}} required{{end}}>
  {{if .Hint}}<p class="hint" data-register-text="field.{{.Name}}.hint"></p>{{end}}
  {{else if eq .Type "tel"}}
  <label for="f_{{.Name}}"><span data-register-text="field.{{.Name}}.label"></span>{{if .Required}} <span class="req" aria-hidden="true">*</span>{{end}}</label>
  <input id="f_{{.Name}}" name="{{.Name}}" type="tel" inputmode="tel" autocomplete="tel"
         data-register-value="{{.Name}}"{{if .Placeholder}} data-register-placeholder="field.{{.Name}}.placeholder"{{end}}{{if .MaxLength}} maxlength="{{.MaxLength}}"{{end}}{{if .Required}} required{{end}}>
  {{if .Hint}}<p class="hint" data-register-text="field.{{.Name}}.hint"></p>{{end}}
  {{else}}
  <label for="f_{{.Name}}"><span data-register-text="field.{{.Name}}.label"></span>{{if .Required}} <span class="req" aria-hidden="true">*</span>{{end}}</label>
  <input id="f_{{.Name}}" name="{{.Name}}" type="text"
         data-register-value="{{.Name}}"{{if .Placeholder}} data-register-placeholder="field.{{.Name}}.placeholder"{{end}}{{if .MaxLength}} maxlength="{{.MaxLength}}"{{end}}{{if .Required}} required{{end}}{{if .Options}} list="dl_{{.Name}}"{{end}}>
  {{if .Options}}
  <datalist id="dl_{{.Name}}">
    {{range $i, $option := .Options}}<option data-register-option="{{$field.Name}}.{{$i}}"></option>{{end}}
  </datalist>
  {{end}}
  {{if .Hint}}<p class="hint" data-register-text="field.{{.Name}}.hint"></p>{{end}}
  {{end}}
</div>
{{end}}
