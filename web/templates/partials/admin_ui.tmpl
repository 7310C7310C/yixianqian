{{else}}<span class="admin-chip admin-chip--muted">状态未知</span>
{{end}}
{{end}}

{{define "admin_redemption_status"}}
{{if eq . "active"}}<span class="admin-chip admin-chip--open"><span class="admin-chip-dot" aria-hidden="true"></span>生效中</span>
{{else if eq . "pending"}}<span class="admin-chip admin-chip--draft"><span class="admin-chip-dot" aria-hidden="true"></span>待处理</span>
{{else if eq . "arranged"}}<span class="admin-chip admin-chip--full">已安排</span>
{{else if eq . "recommended"}}<span class="admin-chip admin-chip--full">已推荐</span>
{{else if eq . "done"}}<span class="admin-chip admin-chip--done">已完成</span>
{{else if eq . "cancelled"}}<span class="admin-chip admin-chip--muted">已取消</span>
{{else if eq . "refunded"}}<span class="admin-chip admin-chip--cancel">已退穗</span>
{{else if .}}<span class="admin-chip admin-chip--muted">{{.}}</span>
{{else}}<span class="admin-chip admin-chip--muted">状态未知</span>
{{end}}
{{end}}

