{{define "admin_activity_status"}}
{{if eq . "报名中"}}<span class="admin-chip admin-chip--open"><span class="admin-chip-dot" aria-hidden="true"></span>报名中</span>
{{else if eq . "未开始报名"}}<span class="admin-chip admin-chip--muted"><span class="admin-chip-dot" aria-hidden="true"></span>未开始报名</span>
{{else if eq . "已满员"}}<span class="admin-chip admin-chip--full"><span class="admin-chip-dot" aria-hidden="true"></span>已满员</span>
{{else if eq . "已结束"}}<span class="admin-chip admin-chip--done"><span class="admin-chip-dot" aria-hidden="true"></span>已结束</span>
{{else if eq . "已取消"}}<span class="admin-chip admin-chip--cancel"><span class="admin-chip-dot" aria-hidden="true"></span>已取消</span>
{{else if eq . "草稿"}}<span class="admin-chip admin-chip--draft"><span class="admin-chip-dot" aria-hidden="true"></span>草稿</span>
{{else if .}}<span class="admin-chip admin-chip--muted"><span class="admin-chip-dot" aria-hidden="true"></span>{{.}}</span>
{{else}}<span class="admin-chip admin-chip--muted">状态未设置</span>
{{end}}
{{end}}

{{define "admin_attendance_status"}}
{{if eq . "按时"}}<span class="admin-chip admin-chip--done">已签到 · 按时</span>
{{else if eq . "迟到"}}<span class="admin-chip admin-chip--draft">已签到 · 迟到</span>
{{else if eq . "未到"}}<span class="admin-chip admin-chip--cancel">未到</span>
{{else}}<span class="admin-chip admin-chip--muted">未签到</span>
{{end}}
{{end}}

