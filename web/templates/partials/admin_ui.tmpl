{{define "admin_empty"}}
<div class="admin-empty">
  <span class="admin-empty-icon" aria-hidden="true">{{template "admin_icon_empty"}}</span>
  <h2 class="admin-empty-title">暂无数据</h2>
  <p>换个筛选条件，或稍后再试。</p>
</div>
{{end}}

{{define "admin_account_status"}}
{{if eq . "pending"}}<span class="admin-chip admin-chip--draft"><span class="admin-chip-dot" aria-hidden="true"></span>待审核</span>
{{else if eq . "active"}}<span class="admin-chip admin-chip--done"><span class="admin-chip-dot" aria-hidden="true"></span>已通过</span>
{{else if eq . "rejected"}}<span class="admin-chip admin-chip--cancel"><span class="admin-chip-dot" aria-hidden="true"></span>已拒绝</span>
{{else if eq . "disabled"}}<span class="admin-chip admin-chip--muted"><span class="admin-chip-dot" aria-hidden="true"></span>已停用</span>
{{else if eq . "matched"}}<span class="admin-chip admin-chip--open"><span class="admin-chip-dot" aria-hidden="true"></span>已脱单</span>
{{else if eq . "left"}}<span class="admin-chip admin-chip--muted"><span class="admin-chip-dot" aria-hidden="true"></span>已退出</span>
{{else if eq . "observer"}}<span class="admin-chip admin-chip--full"><span class="admin-chip-dot" aria-hidden="true"></span>观察员</span>
{{else if .}}<span class="admin-chip admin-chip--muted">{{.}}</span>
{{else}}<span class="admin-chip admin-chip--muted">状态未知</span>
{{end}}
{{end}}

{{define "admin_login_status"}}
{{if eq . "active"}}<span class="admin-chip admin-chip--done">可登录</span>
{{else if eq . "disabled"}}<span class="admin-chip admin-chip--cancel">禁止登录</span>
{{else if .}}<span class="admin-chip admin-chip--muted">{{.}}</span>
{{else}}<span class="admin-chip admin-chip--muted">登录状态未知</span>
{{end}}
{{end}}

{{define "admin_report_status"}}
