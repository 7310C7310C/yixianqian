{{define "content"}}
{{template "admin_nav" .}}

<section class="admin-page-head">
  <div class="admin-page-head-main">
    <p class="admin-eyebrow">用户</p>
    <h1 class="admin-page-title">用户审核与管理</h1>
    <p class="admin-subtitle">
      共 {{.Data.Counts.Total}} 位会员{{if .Data.Counts.Pending}} · 待审核 {{.Data.Counts.Pending}} 位{{end}}。审核、停用与重置密码都会写入审计日志。
    </p>
  </div>
</section>

{{if .Data.TempPassword}}
<div class="admin-temp-password" role="status">
  <h2>临时密码（只显示这一次）</h2>
  <p class="admin-temp-value"><code>{{.Data.TempPassword}}</code></p>
  <p class="hint">有效至 {{.Data.TempExpiresAt}}。请立即转交用户；用户登录后必须修改密码。</p>
</div>
{{end}}
{{template "flash" .}}

<section class="admin-stat-grid" aria-label="用户状态统计">
  <a class="admin-stat" href="/admin/users?status=pending">
    <span class="admin-stat-icon" aria-hidden="true">{{template "admin_icon_users"}}</span>
    <span class="admin-stat-number{{if gt .Data.Counts.Pending 0}} is-warn{{end}}">{{.Data.Counts.Pending}}</span>
    <span class="admin-stat-label">待审核</span>
    <span class="admin-stat-arrow" aria-hidden="true">›</span>
  </a>
  <a class="admin-stat" href="/admin/users?status=active">
    <span class="admin-stat-icon" aria-hidden="true">{{template "admin_icon_check"}}</span>
    <span class="admin-stat-number">{{.Data.Counts.Active}}</span>
    <span class="admin-stat-label">已通过</span>
    <span class="admin-stat-arrow" aria-hidden="true">›</span>
  </a>
  <a class="admin-stat" href="/admin/users?status=rejected">
    <span class="admin-stat-icon" aria-hidden="true">{{template "admin_icon_flag"}}</span>
    <span class="admin-stat-number">{{.Data.Counts.Rejected}}</span>
    <span class="admin-stat-label">已拒绝</span>
    <span class="admin-stat-arrow" aria-hidden="true">›</span>
  </a>
  <a class="admin-stat" href="/admin/users?status=disabled">
    <span class="admin-stat-icon" aria-hidden="true">{{template "admin_icon_shield"}}</span>
    <span class="admin-stat-number">{{.Data.Counts.Disabled}}</span>
    <span class="admin-stat-label">已停用</span>
    <span class="admin-stat-arrow" aria-hidden="true">›</span>
  </a>
</section>

<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">筛选</h2>
      <p class="admin-section-desc">按姓名、昵称、手机或会员编号搜索，再按状态收窄。</p>
    </div>
    <span class="admin-section-meta">全部 {{.Data.Counts.Total}} 位</span>
  </div>

  <form method="get" action="/admin/users" class="admin-filter-bar admin-filter-bar--inline" role="search">
    <label class="admin-visually-hidden" for="admin-user-q">搜寻</label>
    <span class="admin-search">
      {{template "admin_icon_search"}}
      <input id="admin-user-q" class="admin-input" name="q" type="search" value="{{.Data.Query}}"
             placeholder="姓名、昵称、手机或会员编号">
    </span>
    <label class="admin-visually-hidden" for="admin-user-status">状态</label>
    <select id="admin-user-status" name="status" class="admin-select">
      {{range .Data.Statuses}}
      <option value="{{.Value}}"{{if eq $.Data.StatusFilter .Value}} selected{{end}}>{{.Label}}</option>
      {{end}}
    </select>
    <label class="admin-visually-hidden" for="admin-user-per-page">每页条数</label>
    <select id="admin-user-per-page" name="per_page" class="admin-select">
      <option value="20"{{if eq .Data.PerPage 20}} selected{{end}}>每页 20</option>
      <option value="50"{{if eq .Data.PerPage 50}} selected{{end}}>每页 50</option>
      <option value="100"{{if eq .Data.PerPage 100}} selected{{end}}>每页 100</option>
      <option value="200"{{if eq .Data.PerPage 200}} selected{{end}}>每页 200</option>
    </select>
    <button type="submit" class="button primary">查询</button>
  </form>

  <nav class="admin-filter-chips" aria-label="用户状态">
    {{range .Data.Statuses}}
    <a class="admin-chip-btn" href="/admin/users?status={{.Value}}{{if $.Data.Query}}&amp;q={{$.Data.Query | urlquery}}{{end}}{{if ne $.Data.PerPage 50}}&amp;per_page={{$.Data.PerPage}}{{end}}"
       {{if eq $.Data.StatusFilter .Value}}aria-current="page"{{end}}>{{.Label}}</a>
    {{end}}
  </nav>
</section>

<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">会员</h2>
      <p class="admin-section-desc">{{if .Data.Query}}搜索「{{.Data.Query}}」· {{end}}{{if .Data.Total}}显示第 {{.Data.ShowingFrom}}–{{.Data.ShowingTo}} 位，共 {{.Data.Total}} 位{{else}}没有匹配的会员{{end}}</p>
    </div>
    <span class="admin-section-meta">{{if .Data.TotalPages}}第 {{.Data.Page}} / {{.Data.TotalPages}} 页{{else}}共 {{.Data.Total}} 位{{end}}</span>
  </div>

  {{if .Data.Users}}
  <div class="admin-record-list">
    {{range .Data.Users}}
    <article class="admin-record" data-adm-temp-scope>
      <span class="admin-avatar" aria-hidden="true">{{template "admin_icon_users"}}</span>
      <div class="admin-record-main">
        <h3 class="admin-record-title">
          <a href="/admin/users/{{.ID}}">{{.Name}}</a>
          {{template "admin_account_status" .AccountStatus}}
          {{if eq .LoginStatus "disabled"}}{{template "admin_login_status" .LoginStatus}}{{end}}
        </h3>
        <p class="admin-record-sub">
          {{if .Nickname}}{{.Nickname}} · {{end}}<code>{{if .LegacyUserID}}{{.LegacyUserID}}{{else}}#{{.ID}}{{end}}</code>
          · {{.Phone}}
          · 建立于 <time datetime="{{.CreatedAt.Format "2006-01-02"}}">{{.CreatedAt.Format "2006-01-02"}}</time>
        </p>
        <div class="admin-record-meta">
          {{if .Roles}}
          {{range $i, $r := .Roles}}{{if $i}}<span class="admin-visually-hidden">、</span>{{end}}<span class="admin-chip admin-chip--full">{{$r}}</span>{{end}}
          {{else}}<span class="admin-chip admin-chip--muted">无管理角色</span>{{end}}
        </div>
      </div>
      <div class="admin-record-actions">
        <a class="button small" href="/admin/users/{{.ID}}">详情</a>
        {{if and $.Data.CanReview (or $.Data.SuperAdmin (not .AdminProtected)) (or (eq .AccountStatus "pending") (eq .AccountStatus "rejected"))}}
        <form method="post" action="/admin/users/{{.ID}}/approve" class="inline-form">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          {{template "admin_user_list_filters" $}}
          <button type="submit" class="button small primary">通过</button>
        </form>
        {{end}}
        {{if and $.Data.CanReview (or $.Data.SuperAdmin (not .AdminProtected)) (or (eq .AccountStatus "pending") (eq .AccountStatus "rejected"))}}
        <form method="post" action="/admin/users/{{.ID}}/reject" class="inline-form">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          {{template "admin_user_list_filters" $}}
          <button type="submit" class="button small danger" data-adm-confirm="确认拒绝 {{.Name}} 的申请？">拒绝</button>
        </form>
        {{end}}
        {{if and $.Data.CanManage (or $.Data.SuperAdmin (not .AdminProtected)) (eq .LoginStatus "active")}}
        <form method="post" action="/admin/users/{{.ID}}/disable" class="inline-form">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          {{template "admin_user_list_filters" $}}
          <button type="submit" class="button small danger" data-adm-confirm="确认停用 {{.Name}} 的账号？停用后该用户无法登录。">停用</button>
        </form>
        {{end}}
        {{if and $.Data.CanManage (or $.Data.SuperAdmin (not .AdminProtected)) (eq .LoginStatus "disabled") (ne .AccountStatus "pending") (ne .AccountStatus "rejected")}}
        <form method="post" action="/admin/users/{{.ID}}/enable" class="inline-form">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          {{template "admin_user_list_filters" $}}
          <button type="submit" class="button small">恢复</button>
        </form>
        {{end}}
        {{if and $.Data.CanManage (or $.Data.SuperAdmin (not .AdminProtected))}}
        <form method="post" action="/admin/users/{{.ID}}/temp-password" class="inline-form"
              data-adm-temp-form data-user-id="{{.ID}}" data-user-name="{{.Name}}">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          {{template "admin_user_list_filters" $}}
          <button type="submit" class="button small" data-adm-confirm="生成临时密码后，{{.Name}} 的旧密码会立即失效。继续？">临时密码</button>
        </form>
        {{end}}
      </div>
      <div class="admin-temp-inline" data-adm-temp-result hidden aria-live="polite"></div>
    </article>
    {{end}}
  </div>
  {{if gt .Data.TotalPages 1}}
  <nav class="admin-pagination" aria-label="用户分页">
    {{if .Data.PrevURL}}<a class="button small" href="{{.Data.PrevURL}}" rel="prev">上一页</a>{{else}}<span class="button small" aria-disabled="true">上一页</span>{{end}}
    <span class="hint">第 {{.Data.Page}} / {{.Data.TotalPages}} 页 · 共 {{.Data.Total}} 位</span>
    {{if .Data.NextURL}}<a class="button small" href="{{.Data.NextURL}}" rel="next">下一页</a>{{else}}<span class="button small" aria-disabled="true">下一页</span>{{end}}
  </nav>
  {{end}}
  {{else}}
  <div class="admin-empty">
    <span class="admin-empty-icon" aria-hidden="true">{{template "admin_icon_empty"}}</span>
    <h2 class="admin-empty-title">没有符合条件的用户</h2>
    <p>换个状态或搜索词试试；清空搜索可查看全部会员。</p>
    <a class="button" href="/admin/users">清除筛选</a>
  </div>
  {{end}}
</section>
{{end}}

{{define "admin_user_list_filters"}}
<input type="hidden" name="status_filter" value="{{.Data.StatusFilter}}">
<input type="hidden" name="q" value="{{.Data.Query}}">
<input type="hidden" name="page" value="{{.Data.Page}}">
<input type="hidden" name="per_page" value="{{.Data.PerPage}}">
{{end}}
