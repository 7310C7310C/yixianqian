{{define "content"}}
{{template "admin_nav" .}}
{{$activityID := .Data.Activity.ID}}

<section class="admin-page-head admin-workbench-head">
  <div class="admin-page-head-main">
    <div class="admin-breadcrumb">
      <a href="/admin/activities">活动列表</a>
      <span aria-hidden="true">/</span>
      <span>工作台</span>
    </div>
    <div class="admin-workbench-title">
      {{if .Data.Activity.PosterMediaID}}
      <img class="admin-activity-cover" src="/admin/activities/{{$activityID}}/poster?size=thumb" alt="{{.Data.Activity.Name}} 海报" loading="lazy">
      {{else}}
      <span class="admin-activity-cover admin-activity-cover--empty" aria-hidden="true">{{template "admin_icon_image"}}</span>
      {{end}}
      <div class="admin-workbench-title-main">
        <p class="admin-eyebrow">活动工作台</p>
        <h1>{{.Data.Activity.Name}}</h1>
        <div class="admin-meta-row">
          <code>{{.Data.Activity.ActivityNo}}</code>
          {{template "admin_activity_status" .Data.Activity.Status}}
          <span>报名 <strong>{{.Data.Stats.SignupCount}}</strong>{{if gt .Data.Activity.MaxSignup 0}} / {{.Data.Activity.MaxSignup}}{{else}} / 不限{{end}}</span>
          <span>已签到 <strong>{{.Data.Stats.CheckedInCount}}</strong></span>
        </div>
      </div>
    </div>
  </div>
  <div class="admin-page-actions">
    <a class="button" href="/admin/activities">活动列表</a>
    <a class="button" href="#broadcast">📣 广播</a>
    <a class="button primary" href="/admin/activities/{{$activityID}}/edit">编辑资料</a>
  </div>
</section>

{{template "flash" .}}

<section class="admin-section" id="grouping">
  <div class="admin-section-head">
    <div>
      <h2 class="admin-section-title">分组 / 一对一</h2>
      <p class="admin-section-desc">两种模式互斥；执行前请确认名单与签到状态。</p>
    </div>
    <div class="admin-section-meta"><a href="/admin/matching">匹配总览</a></div>
  </div>
  <div class="admin-mode-grid">
    {{if .Data.Activity.GroupEnabled}}
    <a class="admin-mode-card admin-mode-card--on" href="/admin/matching/group/{{$activityID}}">
      <span class="admin-mode-icon" aria-hidden="true">{{template "admin_icon_matching"}}</span>
      <span class="admin-mode-body">
        <span class="admin-mode-title">分组 <span class="admin-chip admin-chip--done">已开启</span></span>
        <span class="admin-mode-desc">{{if .Data.Activity.GroupStatus}}{{.Data.Activity.GroupStatus}}{{else}}待执行分组{{end}} · 进入分组控制台</span>
      </span>
      <span class="admin-mode-arrow" aria-hidden="true">›</span>
    </a>
    {{else}}
    <a class="admin-mode-card" href="#settings">
      <span class="admin-mode-icon" aria-hidden="true">{{template "admin_icon_matching"}}</span>
      <span class="admin-mode-body">
        <span class="admin-mode-title">分组 <span class="admin-chip admin-chip--muted">未开启</span></span>
        <span class="admin-mode-desc">到「设置」开启后，再执行分组</span>
      </span>
      <span class="admin-mode-arrow" aria-hidden="true">›</span>
    </a>
    {{end}}
    {{if .Data.Activity.OnetooneEnabled}}
    <a class="admin-mode-card admin-mode-card--on" href="/admin/matching/onetoone/{{$activityID}}">
      <span class="admin-mode-icon" aria-hidden="true">{{template "admin_icon_heart"}}</span>
      <span class="admin-mode-body">
        <span class="admin-mode-title">一对一 <span class="admin-chip admin-chip--done">已开启</span></span>
        <span class="admin-mode-desc">{{if .Data.Activity.OnetooneStatus}}{{.Data.Activity.OnetooneStatus}}{{else}}待执行一对一{{end}} · 进入一对一控制台</span>
      </span>
      <span class="admin-mode-arrow" aria-hidden="true">›</span>
    </a>
    {{else}}
    <a class="admin-mode-card" href="#settings">
      <span class="admin-mode-icon" aria-hidden="true">{{template "admin_icon_heart"}}</span>
      <span class="admin-mode-body">
        <span class="admin-mode-title">一对一 <span class="admin-chip admin-chip--muted">未开启</span></span>
        <span class="admin-mode-desc">到「设置」开启后，再执行一对一</span>
      </span>
      <span class="admin-mode-arrow" aria-hidden="true">›</span>
    </a>
    {{end}}
  </div>
  {{if and .Data.Activity.GroupEnabled .Data.Activity.OnetooneEnabled}}
  <div class="admin-alert admin-alert--error admin-gap-top" role="alert">
    <span><strong>双开冲突：</strong>分组与一对一不能同时开启，执行任一控制台都会被后端拒绝。请到「设置」关闭其中一个模式。</span>
  </div>
  {{end}}

  <details class="admin-details admin-gap-top">
    <summary>查看活动资料</summary>
    <div class="admin-activity-grid">
      <div class="admin-activity-item">
        <span class="admin-activity-label">开始时间</span>
        <span>{{if .Data.Activity.StartAt}}{{.Data.Activity.StartAt.Format "2006-01-02 15:04"}}{{else}}—{{end}}</span>
      </div>
      <div class="admin-activity-item">
        <span class="admin-activity-label">结束时间</span>
        <span>{{if .Data.Activity.EndAt}}{{.Data.Activity.EndAt.Format "2006-01-02 15:04"}}{{else}}—{{end}}</span>
      </div>
      <div class="admin-activity-item">
        <span class="admin-activity-label">地点</span>
        <span>{{if .Data.Activity.Location}}{{.Data.Activity.Location}}{{else}}—{{end}}</span>
      </div>
      <div class="admin-activity-item">
        <span class="admin-activity-label">费用</span>
        <span>{{if .Data.Activity.Fee}}{{.Data.Activity.Fee}}{{else}}—{{end}}</span>
      </div>
      <div class="admin-activity-item">
        <span class="admin-activity-label">参加条件</span>
        <span>{{if .Data.Activity.Condition}}{{.Data.Activity.Condition}}{{else}}—{{end}}</span>
      </div>
      <div class="admin-activity-item">
        <span class="admin-activity-label">食宿</span>
        <span>{{if .Data.Activity.Food}}{{.Data.Activity.Food}}{{else}}—{{end}}</span>
      </div>
      <div class="admin-activity-item">
        <span class="admin-activity-label">发布时间</span>
        <span>{{if .Data.Activity.PublishAt}}{{.Data.Activity.PublishAt.Format "2006-01-02 15:04"}}{{else}}—{{end}}</span>
      </div>
      <div class="admin-activity-item">
        <span class="admin-activity-label">签到码</span>
        <span>{{if .Data.Activity.SigninCode}}{{.Data.Activity.SigninCode}}{{else}}—{{end}}</span>
      </div>
    </div>
  </details>
</section>

<nav class="admin-tabbar" data-adm-tabs role="tablist" aria-label="活动工作区">
  <a class="admin-tab" id="tab-roster" href="#roster" role="tab" data-adm-tab="roster" aria-controls="roster" aria-selected="true">报名名单 <span class="admin-tab-count">{{.Data.RosterAllCount}}</span></a>
  <a class="admin-tab" id="tab-signin" href="#signin" role="tab" data-adm-tab="signin" aria-controls="signin" aria-selected="false">签到 <span class="admin-tab-count">{{.Data.Stats.CheckedInCount}}</span></a>
  <a class="admin-tab" id="tab-broadcast" href="#broadcast" role="tab" data-adm-tab="broadcast" aria-controls="broadcast" aria-selected="false">广播</a>
  <a class="admin-tab" id="tab-settings" href="#settings" role="tab" data-adm-tab="settings" aria-controls="settings" aria-selected="false">设置</a>
</nav>

<div data-adm-panels>
  <section class="admin-panel" id="roster" data-adm-panel="roster" role="tabpanel" aria-labelledby="tab-roster">
    <div class="admin-section">
      <div class="admin-section-head">
        <div>
          <h2 class="admin-section-title">报名/签到名单</h2>
          <p class="admin-section-desc">搜索姓名、昵称、编号或手机后四位；签到操作会记录审计日志。</p>
        </div>
        <div class="admin-section-meta">
          {{if .Data.Activity.GroupEnabled}}<a class="button small" href="/admin/matching/group/{{$activityID}}">分组控制台</a>{{end}}
          {{if .Data.Activity.OnetooneEnabled}}<a class="button small" href="/admin/matching/onetoone/{{$activityID}}">一对一控制台</a>{{end}}
        </div>
      </div>
      <p class="admin-counts">
        <span>有效报名 <strong>{{.Data.Stats.SignupCount}}</strong> 人</span>
        <span>已签到 <strong>{{.Data.Stats.CheckedInCount}}</strong> 人</span>
        {{if .Data.RosterHasFilter}}<span>筛选结果 <strong>{{.Data.RosterFilteredCount}}</strong> / {{.Data.RosterAllCount}} 人</span>{{end}}
      </p>
      {{if and .Data.RosterNotice (eq .Data.RosterNoticeUserID 0)}}<div class="admin-alert admin-alert--ok" role="status">{{.Data.RosterNotice}}</div>{{end}}

      <form method="get" action="/admin/activities/{{$activityID}}#roster" class="admin-roster-filter" role="search">
        <label>搜索
          <input class="admin-input" type="search" name="q" value="{{.Data.RosterQuery}}" placeholder="姓名、昵称、编号或手机后四位">
        </label>
        <label>出席
          <select class="admin-select" name="attendance">
            <option value="all"{{if eq .Data.RosterAttendance ""}} selected{{end}}>全部</option>
            <option value="checked"{{if eq .Data.RosterAttendance "checked"}} selected{{end}}>已签到</option>
            <option value="unchecked"{{if eq .Data.RosterAttendance "unchecked"}} selected{{end}}>未签到</option>
            <option value="late"{{if eq .Data.RosterAttendance "late"}} selected{{end}}>迟到</option>
            <option value="absent"{{if eq .Data.RosterAttendance "absent"}} selected{{end}}>未到</option>
          </select>
        </label>
        <button type="submit" class="button">筛选</button>
        {{if .Data.RosterHasFilter}}<a class="button" href="{{.Data.RosterClearURL}}">清除</a>{{end}}
      </form>

      {{if .Data.Roster}}
      <div class="admin-roster-list">
        {{range .Data.Roster}}
        <article class="admin-roster-item" id="member-{{.UserID}}">
          <div class="admin-roster-main">
            <div class="admin-roster-name">
              <span>{{.Name}}</span>
              {{if .LegacyUserID}}<span class="admin-roster-id">{{.LegacyUserID}}</span>{{end}}
            </div>
            <div class="admin-roster-sub">
              {{if .Nickname}}昵称：{{.Nickname}}{{end}}{{if and .Nickname .PhoneMasked}} · {{end}}{{if .PhoneMasked}}手机：{{.PhoneMasked}}{{end}}
            </div>
            {{if and $.Data.RosterNotice (eq .UserID $.Data.RosterNoticeUserID)}}<div class="alert alert-ok admin-row-notice" role="status">{{$.Data.RosterNotice}}</div>{{end}}
          </div>
          <div class="admin-roster-meta">
            <span>{{if .Gender}}{{.Gender}}{{else}}—{{end}}</span>
            <span>报名 {{.SignupAt.Format "2006-01-02 15:04"}}</span>
          </div>
          <div class="admin-roster-status">{{template "admin_attendance_status" .Attendance}}</div>
          <div class="admin-roster-actions">
            <form method="post" action="/admin/activities/{{$activityID}}/attendance">
              <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
              <input type="hidden" name="user_id" value="{{.UserID}}">
              <input type="hidden" name="attendance_state" value="按时">
              <input type="hidden" name="q" value="{{$.Data.RosterQuery}}">
              <input type="hidden" name="attendance" value="{{$.Data.RosterAttendance}}">
              <input type="hidden" name="page" value="{{$.Data.RosterPage}}">
              <input type="hidden" name="return_to" value="{{$.Data.RosterReturnTo}}">
              <button type="submit" class="button small" title="按时签到">按时</button>
            </form>
            <form method="post" action="/admin/activities/{{$activityID}}/attendance">
              <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
              <input type="hidden" name="user_id" value="{{.UserID}}">
              <input type="hidden" name="attendance_state" value="迟到">
              <input type="hidden" name="q" value="{{$.Data.RosterQuery}}">
              <input type="hidden" name="attendance" value="{{$.Data.RosterAttendance}}">
              <input type="hidden" name="page" value="{{$.Data.RosterPage}}">
              <input type="hidden" name="return_to" value="{{$.Data.RosterReturnTo}}">
              <button type="submit" class="button small" title="标记迟到">迟到</button>
            </form>
            <form method="post" action="/admin/activities/{{$activityID}}/attendance">
              <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
              <input type="hidden" name="user_id" value="{{.UserID}}">
              <input type="hidden" name="attendance_state" value="未到">
              <input type="hidden" name="q" value="{{$.Data.RosterQuery}}">
              <input type="hidden" name="attendance" value="{{$.Data.RosterAttendance}}">
              <input type="hidden" name="page" value="{{$.Data.RosterPage}}">
              <input type="hidden" name="return_to" value="{{$.Data.RosterReturnTo}}">
              <button type="submit" class="button small" title="标记未到" data-adm-confirm="确定把该会员标记为未到？">未到</button>
            </form>
            {{if .Attendance}}
            <form method="post" action="/admin/activities/{{$activityID}}/attendance">
              <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
              <input type="hidden" name="user_id" value="{{.UserID}}">
              <input type="hidden" name="attendance_state" value="">
              <input type="hidden" name="q" value="{{$.Data.RosterQuery}}">
              <input type="hidden" name="attendance" value="{{$.Data.RosterAttendance}}">
              <input type="hidden" name="page" value="{{$.Data.RosterPage}}">
              <input type="hidden" name="return_to" value="{{$.Data.RosterReturnTo}}">
              <button type="submit" class="button small danger" title="取消签到" data-adm-confirm="确定取消该会员的签到？">取消签到</button>
            </form>
            {{end}}
          </div>
        </article>
        {{end}}
      </div>
      {{if gt .Data.RosterPageCount 1}}
      <nav class="admin-pagination" aria-label="名单分页">
        <span class="hint">第 {{.Data.RosterPage}} / {{.Data.RosterPageCount}} 页 · 共 {{.Data.RosterFilteredCount}} 人</span>
        <span class="admin-actions">
          {{if .Data.RosterPrevURL}}<a class="button small" href="{{.Data.RosterPrevURL}}">上一页</a>{{end}}
          {{if .Data.RosterNextURL}}<a class="button small" href="{{.Data.RosterNextURL}}">下一页</a>{{end}}
        </span>
      </nav>
      {{end}}
      {{else if gt .Data.RosterAllCount 0}}
      <div class="admin-empty">
        <span class="admin-empty-icon" aria-hidden="true">{{template "admin_icon_search"}}</span>
        <h2>没有符合条件的报名者</h2>
        <p>试试清除搜索关键字或切换出席筛选。</p>
        <a class="button" href="{{.Data.RosterClearURL}}">清除筛选</a>
      </div>
      {{else}}
      <div class="admin-empty">
        <span class="admin-empty-icon" aria-hidden="true">{{template "admin_icon_users"}}</span>
        <h2>暂无有效报名</h2>
        <p>用户报名后会显示在这里；可以先分享活动或检查活动状态。</p>
        <a class="button" href="/admin/activities">返回活动列表</a>
      </div>
      {{end}}
    </div>
  </section>

  <section class="admin-panel" id="signin" data-adm-panel="signin" role="tabpanel" aria-labelledby="tab-signin">
    <div class="admin-section">
      <div class="admin-section-head">
        <div>
          <h2 class="admin-section-title">现场签到</h2>
          <p class="admin-section-desc">把 4 位码展示给会员，或由工作人员在名单中直接签到。</p>
        </div>
        <div class="admin-section-meta">
          {{if .Data.Activity.SigninEnabled}}<span class="admin-chip admin-chip--done">签到已开启</span>{{else}}<span class="admin-chip admin-chip--muted">签到未开启</span>{{end}}
        </div>
      </div>

      <div class="admin-signin-card{{if not .Data.Activity.SigninEnabled}} is-off{{end}}">
        <span class="admin-signin-label">现场签到码</span>
        {{if .Data.Activity.SigninCode}}
        <div class="admin-signin-code-value" aria-label="签到码 {{.Data.Activity.SigninCode}}">{{.Data.Activity.SigninCode}}</div>
        {{else}}
        <div class="admin-signin-code-value is-empty">----</div>
        {{end}}
        <p class="admin-signin-code-hint">
          {{if .Data.Activity.SigninEnabled}}会员在活动页输入这 4 位数字完成签到。{{else}}签到尚未开启，可在下方「设置」中开启并填写 4 位码。{{end}}
        </p>
        {{if .Data.Activity.SigninCode}}
        <div class="admin-actions admin-actions--center">
          <button type="button" class="button small" data-adm-copy="{{.Data.Activity.SigninCode}}" data-adm-copy-label="复制签到码">复制签到码</button>
          <a class="button small" href="#settings">修改签到码</a>
        </div>
        {{else}}
        <div class="admin-actions admin-actions--center">
          <a class="button small primary" href="#settings">去设置签到码</a>
        </div>
        {{end}}
      </div>

      <div class="admin-signin-stats" data-adm-signin-stats data-signup="{{.Data.Stats.SignupCount}}" data-checked="{{.Data.Stats.CheckedInCount}}">
        <div class="admin-signin-stat">
          <strong data-adm-stat="checked">{{.Data.Stats.CheckedInCount}}</strong>
          <span>已签到</span>
        </div>
        <div class="admin-signin-stat">
          <strong data-adm-stat="unchecked">—</strong>
          <span>未签到</span>
        </div>
        <div class="admin-signin-stat">
          <strong data-adm-stat="rate">—</strong>
          <span>签到率</span>
        </div>
      </div>

      <form method="get" action="/admin/activities/{{$activityID}}#signin" class="admin-roster-filter" role="search">
        <label>搜索
          <input class="admin-input" type="search" name="q" value="{{.Data.RosterQuery}}" placeholder="姓名、昵称、编号或手机后四位">
        </label>
        <label>出席
          <select class="admin-select" name="attendance">
            <option value="all"{{if eq .Data.RosterAttendance ""}} selected{{end}}>全部</option>
            <option value="unchecked"{{if eq .Data.RosterAttendance "unchecked"}} selected{{end}}>未签到</option>
            <option value="checked"{{if eq .Data.RosterAttendance "checked"}} selected{{end}}>已签到</option>
            <option value="late"{{if eq .Data.RosterAttendance "late"}} selected{{end}}>迟到</option>
            <option value="absent"{{if eq .Data.RosterAttendance "absent"}} selected{{end}}>未到</option>
          </select>
        </label>
        <button type="submit" class="button">筛选</button>
        {{if .Data.RosterHasFilter}}<a class="button" href="{{.Data.RosterClearURL}}">清除</a>{{end}}
      </form>

      {{if .Data.Roster}}
      <div class="admin-roster-list">
        {{range .Data.Roster}}
        <article class="admin-roster-item">
          <div class="admin-roster-main">
            <div class="admin-roster-name">
              <span>{{.Name}}</span>
              {{if .LegacyUserID}}<span class="admin-roster-id">{{.LegacyUserID}}</span>{{end}}
            </div>
            <div class="admin-roster-sub">{{if .PhoneMasked}}手机：{{.PhoneMasked}}{{else}}—{{end}}</div>
          </div>
          <div class="admin-roster-meta">
            <span>{{if .Gender}}{{.Gender}}{{else}}—{{end}}</span>
            <span>报名 {{.SignupAt.Format "01-02 15:04"}}</span>
          </div>
          <div class="admin-roster-status">{{template "admin_attendance_status" .Attendance}}</div>
          <div class="admin-roster-actions">
            {{if .Attendance}}
            <form method="post" action="/admin/activities/{{$activityID}}/attendance">
              <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
              <input type="hidden" name="user_id" value="{{.UserID}}">
              <input type="hidden" name="attendance_state" value="">
              <input type="hidden" name="q" value="{{$.Data.RosterQuery}}">
              <input type="hidden" name="attendance" value="{{$.Data.RosterAttendance}}">
              <input type="hidden" name="page" value="{{$.Data.RosterPage}}">
              <input type="hidden" name="return_to" value="{{$.Data.RosterReturnTo}}">
              <button type="submit" class="button small danger" data-adm-confirm="确定取消该会员的签到？">取消签到</button>
            </form>
            {{else}}
            <form method="post" action="/admin/activities/{{$activityID}}/attendance">
              <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
              <input type="hidden" name="user_id" value="{{.UserID}}">
              <input type="hidden" name="attendance_state" value="按时">
              <input type="hidden" name="q" value="{{$.Data.RosterQuery}}">
              <input type="hidden" name="attendance" value="{{$.Data.RosterAttendance}}">
              <input type="hidden" name="page" value="{{$.Data.RosterPage}}">
              <input type="hidden" name="return_to" value="{{$.Data.RosterReturnTo}}">
              <button type="submit" class="button small primary" title="按时签到">签到</button>
            </form>
            <form method="post" action="/admin/activities/{{$activityID}}/attendance">
              <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
              <input type="hidden" name="user_id" value="{{.UserID}}">
              <input type="hidden" name="attendance_state" value="迟到">
              <input type="hidden" name="q" value="{{$.Data.RosterQuery}}">
              <input type="hidden" name="attendance" value="{{$.Data.RosterAttendance}}">
              <input type="hidden" name="page" value="{{$.Data.RosterPage}}">
              <input type="hidden" name="return_to" value="{{$.Data.RosterReturnTo}}">
              <button type="submit" class="button small" title="标记迟到">迟到</button>
            </form>
            {{end}}
          </div>
        </article>
        {{end}}
      </div>
      {{if gt .Data.RosterPageCount 1}}
      <nav class="admin-pagination" aria-label="签到名单分页">
        <span class="hint">第 {{.Data.RosterPage}} / {{.Data.RosterPageCount}} 页 · 共 {{.Data.RosterFilteredCount}} 人</span>
        <span class="admin-actions">
          {{if .Data.RosterPrevURL}}<a class="button small" href="{{.Data.RosterPrevURL}}" data-adm-signin-page>上一页</a>{{end}}
          {{if .Data.RosterNextURL}}<a class="button small" href="{{.Data.RosterNextURL}}" data-adm-signin-page>下一页</a>{{end}}
        </span>
      </nav>
      {{end}}
      <p class="admin-field-hint admin-field-hint--spaced">签到或取消后会回到「报名名单」并定位到该会员；筛选条件会保留。</p>
      {{else}}
      <div class="admin-empty">
        <span class="admin-empty-icon" aria-hidden="true">{{template "admin_icon_users"}}</span>
        <h2>暂无有效报名</h2>
        <p>用户报名后会显示在这里，现场签到码仍然可用。</p>
      </div>
      {{end}}
    </div>
  </section>

  <section class="admin-panel" id="broadcast" data-adm-panel="broadcast" role="tabpanel" aria-labelledby="tab-broadcast">
    <div class="admin-section">
      <div class="admin-section-head">
        <div>
          <h2 class="admin-section-title">站内广播</h2>
          <p class="admin-section-desc">只发送站内通知，不经过飞书；同一份广播重复提交不会重复发送。</p>
        </div>
      </div>
      <p class="admin-broadcast-audience">
        <span>报名者 <strong>{{.Data.SignupAudienceCount}}</strong> 人</span>
        <span>观察员（全站） <strong>{{.Data.ObserverAudienceCount}}</strong> 人</span>
        <span>全站单身会员 <strong>{{.Data.SingleAudienceCount}}</strong> 人</span>
        <span>去重后合计 <strong>{{.Data.AudienceTotal}}</strong> 人</span>
      </p>
      {{if .Data.BroadcastNotice}}<div class="admin-alert admin-alert--ok" role="status">{{.Data.BroadcastNotice}}</div>{{end}}
      {{if .Data.BroadcastError}}<div class="admin-alert admin-alert--error" role="alert">{{.Data.BroadcastError}}</div>{{end}}
      {{if .Data.BroadcastPreview}}
      <div class="admin-confirm" role="status">
        <strong>确认发送？</strong>
        <p>收件人群组：{{.Data.BroadcastAudienceLabel}}；去重后 <strong>{{.Data.BroadcastPreviewCount}}</strong> 人。发送后无法撤回，但重复提交不会重复发送。</p>
      </div>
      {{end}}
      <form method="post" action="/admin/activities/{{$activityID}}/broadcast#broadcast" class="admin-broadcast">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="broadcast_key" value="{{.Data.BroadcastKey}}">
        {{if .Data.BroadcastPreviewToken}}<input type="hidden" name="broadcast_preview_token" value="{{.Data.BroadcastPreviewToken}}">{{end}}
        <label class="admin-check-row">
          <span class="admin-check-copy">
            <strong>报名者（本活动有效报名）</strong>
            <span>只发给本活动有效报名的会员</span>
          </span>
          <input type="checkbox" name="include_signups" value="1"{{if .Data.BroadcastIncludeSignups}} checked{{end}}>
        </label>
        <label class="admin-check-row">
          <span class="admin-check-copy">
            <strong>观察员（全站）</strong>
            <span>全站启用观察员身份的账号，不限本活动</span>
          </span>
          <input type="checkbox" name="include_observers" value="1"{{if .Data.BroadcastIncludeObservers}} checked{{end}}>
        </label>
        <label class="admin-check-row">
          <span class="admin-check-copy">
            <strong>全站单身会员</strong>
            <span>全站在册、审核通过的单身会员（不含观察员、待审核、已脱单、已退出与停用账号）</span>
          </span>
          <input type="checkbox" name="include_singles" value="1"{{if .Data.BroadcastIncludeSingles}} checked{{end}}>
        </label>
        <label class="admin-field">
          <span class="admin-field-label">通知标题</span>
          <input class="admin-input" type="text" name="broadcast_title" maxlength="100" required value="{{.Data.BroadcastTitle}}" placeholder="例如：本周活动集合提醒">
        </label>
        <label class="admin-field">
          <span class="admin-field-label">通知内容</span>
          <textarea class="admin-textarea" name="broadcast_body" rows="4" maxlength="2000" placeholder="集合时间、地点或需要携带的物品">{{.Data.BroadcastBody}}</textarea>
        </label>
        <div class="admin-actions">
          <button type="submit" name="broadcast_action" value="preview" class="button" formnovalidate>{{if .Data.BroadcastPreview}}重新预览{{else}}预览收件人{{end}}</button>
          {{if .Data.BroadcastPreview}}<button type="submit" name="broadcast_action" value="send" class="button primary" data-adm-confirm="确认发送给 {{.Data.BroadcastPreviewCount}} 人？发送后无法撤回。">确认发送给 {{.Data.BroadcastPreviewCount}} 人</button>{{end}}
        </div>
      </form>
    </div>
  </section>

  <section class="admin-panel" id="settings" data-adm-panel="settings" role="tabpanel" aria-labelledby="tab-settings">
    <div class="admin-section">
      <div class="admin-section-head">
        <div>
          <h2 class="admin-section-title">快速设置</h2>
          <p class="admin-section-desc">保存后返回工作台；名称、描述、时间等完整资料请使用「编辑资料」。</p>
        </div>
      </div>
      <form method="post" action="/admin/activities/{{$activityID}}#settings" class="admin-form">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <input type="hidden" name="name" value="{{.Data.Activity.Name}}">
        <input type="hidden" name="description" value="{{.Data.Activity.Description}}">
        <input type="hidden" name="location" value="{{.Data.Activity.Location}}">
        <input type="hidden" name="condition" value="{{.Data.Activity.Condition}}">
        <input type="hidden" name="max_signup" value="{{.Data.Activity.MaxSignup}}">
        <input type="hidden" name="fee" value="{{.Data.Activity.Fee}}">
        <input type="hidden" name="food" value="{{.Data.Activity.Food}}">
        <input type="hidden" name="publish_at" value="{{if .Data.Activity.PublishAt}}{{.Data.Activity.PublishAt.Format "2006-01-02T15:04"}}{{end}}">
        <input type="hidden" name="start_at" value="{{if .Data.Activity.StartAt}}{{.Data.Activity.StartAt.Format "2006-01-02T15:04"}}{{end}}">
        <input type="hidden" name="end_at" value="{{if .Data.Activity.EndAt}}{{.Data.Activity.EndAt.Format "2006-01-02T15:04"}}{{end}}">
        <label class="admin-field">
          <span class="admin-field-label">活动状态</span>
          <select class="admin-select" name="status">
            {{if .Data.StatusKeep}}<option value="{{.Data.StatusUnknown}}" selected>保持目前状态{{if .Data.StatusUnknown}}（{{.Data.StatusUnknown}}）{{else}}（未设置）{{end}}</option>{{end}}
            {{$current := .Data.Activity.Status}}
            {{range .Data.Statuses}}<option value="{{.}}"{{if eq . $current}} selected{{end}}>{{.}}</option>{{end}}
          </select>
        </label>
        <label class="admin-check-row">
          <span class="admin-check-copy">
            <strong>开启现场签到</strong>
            <span>会员在活动页输入 4 位码签到</span>
          </span>
          <input type="checkbox" name="signin_enabled" value="1"{{if .Data.Activity.SigninEnabled}} checked{{end}}>
        </label>
        <label class="admin-field">
          <span class="admin-field-label">4 位签到码</span>
          <input class="admin-input" type="text" name="signin_code" maxlength="4" inputmode="numeric" value="{{.Data.Activity.SigninCode}}" placeholder="例如 0123" pattern="[0-9]{4}">
        </label>
        <label class="admin-check-row">
          <span class="admin-check-copy">
            <strong>开启分组</strong>
            <span>按性别与每组人数生成分组结果</span>
          </span>
          <input type="checkbox" name="group_enabled" value="1"{{if .Data.Activity.GroupEnabled}} checked{{end}}>
        </label>
        <div class="admin-field-row">
          <label class="admin-field">
            <span class="admin-field-label">每组男生</span>
            <input class="admin-input" type="number" name="male_per_group" min="0" value="{{.Data.Activity.MalePerGroup}}" inputmode="numeric">
          </label>
          <label class="admin-field">
            <span class="admin-field-label">每组女生</span>
            <input class="admin-input" type="number" name="female_per_group" min="0" value="{{.Data.Activity.FemalePerGroup}}" inputmode="numeric">
          </label>
        </div>
        <label class="admin-check-row">
          <span class="admin-check-copy">
            <strong>开启一对一</strong>
            <span>按轮次执行一对一匹配；不能与分组同时开启</span>
          </span>
          <input type="checkbox" name="onetoone_enabled" value="1"{{if .Data.Activity.OnetooneEnabled}} checked{{end}}>
        </label>
        <div class="admin-actions">
          <button type="submit" class="button primary">保存快速设置</button>
        </div>
      </form>
    </div>

    <div class="admin-section">
      <div class="admin-section-head">
        <div>
          <h2 class="admin-section-title">活动海报</h2>
          <p class="admin-section-desc">只接受 JPEG/PNG，最大 {{.MediaMaxMB}} MB；上传后经应用私有代理显示。</p>
        </div>
      </div>
      {{if .Data.Activity.PosterMediaID}}
      <div class="admin-poster">
        <img src="/admin/activities/{{$activityID}}/poster?size=thumb" alt="{{.Data.Activity.Name}} 海报" loading="lazy">
      </div>
      <p class="admin-field-hint">当前海报已上传；替换后用户端会显示新图。</p>
      {{else}}
      <div class="admin-upload-empty">
        <strong>还没有海报</strong>
        <p class="admin-field-hint">上传后会在用户端活动列表与详情中显示。</p>
      </div>
      {{end}}
      <form method="post" action="/admin/activities/{{$activityID}}/poster" enctype="multipart/form-data" class="admin-form">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <label class="admin-field">
          <span class="admin-field-label">选择图片</span>
          <input type="file" name="file" accept="image/jpeg,image/png" required>
        </label>
        <div class="admin-actions">
          <button type="submit" class="button primary">{{if .Data.Activity.PosterMediaID}}替换海报{{else}}上传海报{{end}}</button>
        </div>
      </form>
    </div>
  </section>
</div>

<nav class="admin-back-top" aria-label="返回顶部">
  <a class="button small" href="#main">回到顶部</a>
</nav>
{{end}}
