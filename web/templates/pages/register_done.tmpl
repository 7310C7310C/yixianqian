{{define "content"}}
<section class="card narrow register-done">
  <p class="eyebrow" data-copy-text="register_done.eyebrow"></p>
  <h1 data-copy-text="{{.Data.CopyKey}}.heading"></h1>
  <p class="muted" data-copy-text="{{.Data.CopyKey}}.message"></p>

  {{if .Data.PhoneMasked}}
  <p class="hint"><span data-copy-text="register_done.phoneLabel"></span>{{.Data.PhoneMasked}}</p>
  {{end}}

  <div class="register-done-actions">
    {{if .Data.CanEnter}}
    <a class="button primary block" href="/cards" data-copy-text="register_done.enter"></a>
    <a class="button block" href="/profile" data-copy-text="register_done.profile"></a>
    {{else if .Data.LoggedIn}}
    <p class="hint" data-copy-text="register_done.pendingHint"></p>
    <form method="post" action="/logout" class="stack">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <button type="submit" class="button block" data-copy-text="register_done.logout"></button>
    </form>
    {{else}}
    <a class="button primary block" href="/login" data-copy-text="register_done.loginCta"></a>
    <a class="button block" href="/register" data-copy-text="register_done.registerCta"></a>
    {{end}}
  </div>

  {{if .Data.HasAngelQR}}
  <div class="register-angel-qr">
    <img src="/angel-qr?v={{.Data.AngelQRVersion}}" alt="" width="220" height="299" loading="lazy">
    <p class="hint" data-copy-text="register_done.angelHint"></p>
  </div>
  {{end}}

  <div class="register-note">
    <h2 data-copy-text="register_done.nextTitle"></h2>
    <p data-copy-text="register_done.nextBody"></p>
    <p class="hint" data-copy-text="register_done.privacyHint"></p>
  </div>
</section>
{{end}}
