{{define "content"}}
{{template "admin_nav" .}}

<section class="admin-page-head">
  <div class="admin-page-head-main">
    <p class="admin-eyebrow">系统</p>
    <h1 class="admin-page-title">审计日志</h1>
    <p class="admin-subtitle">
      按创建时间倒序显示，每页 100 条，共 {{.Data.Total}} 条记录{{if .Data.PageCount}}，第 {{.Data.Page}} / {{.Data.PageCount}} 页{{end}}。
      CSV 最多导出 10,000 条；密码、Token、Cookie、对象键等敏感值会以 [redacted] 替代。
    </p>
  </div>
  <div class="admin-page-actions">
    <a class="button primary" href="{{.Data.ExportURL}}">
      {{template "admin_icon_export"}}导出 CSV
    </a>
  </div>
</section>

{{template "flash" .}}

<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">筛选</h2>
      <p class="admin-section-desc">按操作人、操作、对象与日期收窄，留空表示不限。</p>
    </div>
  </div>
  <form class="admin-form-grid admin-audit-filter" method="get" action="/admin/audit">
    <div class="admin-field">
      <label class="admin-field-label" for="audit-actor">操作人</label>
      <input id="audit-actor" class="admin-input" type="text" name="actor" value="{{.Data.Filter.Actor}}" placeholder="姓名 / 会员编号 / 手机">
    </div>
    <div class="admin-field">
      <label class="admin-field-label" for="audit-action">操作</label>
      <input id="audit-action" class="admin-input" type="text" name="action" value="{{.Data.Filter.Action}}" placeholder="如 admin.user.approve">
    </div>
    <div class="admin-field">
      <label class="admin-field-label" for="audit-target-type">对象类型</label>
      <input id="audit-target-type" class="admin-input" type="text" name="target_type" value="{{.Data.Filter.TargetType}}" placeholder="如 user / activity">
    </div>
    <div class="admin-field">
      <label class="admin-field-label" for="audit-target-id">对象 ID</label>
      <input id="audit-target-id" class="admin-input" type="text" name="target_id" value="{{.Data.Filter.TargetID}}" placeholder="完整匹配">
    </div>
    <div class="admin-field">
      <label class="admin-field-label" for="audit-from">开始日期</label>
      <input id="audit-from" class="admin-input" type="date" name="from" value="{{.Data.Filter.From}}">
    </div>
    <div class="admin-field">
      <label class="admin-field-label" for="audit-to">结束日期</label>
      <input id="audit-to" class="admin-input" type="date" name="to" value="{{.Data.Filter.To}}">
    </div>
    <div class="admin-form-actions">
      <button type="submit" class="button primary">筛选</button>
      <a class="button" href="/admin/audit">重置</a>
    </div>
  </form>
</section>

{{if .Data.LoadError}}
<p class="admin-alert admin-alert--error" role="alert">{{.Data.LoadError}}</p>
{{end}}

<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">记录</h2>
      <p class="admin-section-desc">最新动作在前；展开「详情」查看元数据。</p>
    </div>
    <span class="admin-section-meta">本页 {{len .Data.Rows}} 条</span>
  </div>
  {{if .Data.Rows}}
  <div class="admin-record-list">
    {{range .Data.Rows}}
    <article class="admin-record">
      <div class="admin-record-main">
        <h3 class="admin-record-title admin-audit-entry">
          <time datetime="{{.CreatedAt}}">{{.CreatedAt}}</time>
          <code>{{.Action}}</code>
          {{if .TargetType}}<span class="admin-chip admin-chip--muted">{{.TargetType}}</span>{{end}}
        </h3>
        <p class="admin-record-sub">
          操作人：
          {{if .ActorURL}}<a href="{{.ActorURL}}">{{if .ActorName}}{{.ActorName}}{{else}}—{{end}}</a>{{else if .ActorName}}{{.ActorName}}{{else}}—{{end}}
          {{if .ActorLegacyID}} · <code>{{.ActorLegacyID}}</code>{{end}}
          {{if .IP}} · IP {{.IP}}{{end}}
          · 对象：
          {{if .TargetURL}}<a href="{{.TargetURL}}">{{.TargetID}}</a>{{else if .TargetID}}{{.TargetID}}{{else}}—{{end}}
        </p>
        {{if .Metadata}}
        <details class="admin-audit-more">
          <summary>详情</summary>
          <p class="admin-audit-detail">{{.Metadata}}</p>
        </details>
        {{end}}
      </div>
    </article>
    {{end}}
  </div>
  {{else}}
  <div class="admin-empty">
    <span class="admin-empty-icon" aria-hidden="true">{{template "admin_icon_audit"}}</span>
    <h2 class="admin-empty-title">目前没有符合条件的审计记录</h2>
    <p>放宽筛选条件或清空日期再试。</p>
  </div>
  {{end}}

  {{if or .Data.PrevURL .Data.NextURL}}
  <nav class="admin-pagination" aria-label="审计分页">
    {{if .Data.PrevURL}}<a class="button small" href="{{.Data.PrevURL}}">上一页</a>{{else}}<span></span>{{end}}
    {{if .Data.PageCount}}<span class="hint">第 {{.Data.Page}} / {{.Data.PageCount}} 页</span>{{end}}
    {{if .Data.NextURL}}<a class="button small" href="{{.Data.NextURL}}">下一页</a>{{end}}
  </nav>
  {{end}}
</section>
{{end}}
