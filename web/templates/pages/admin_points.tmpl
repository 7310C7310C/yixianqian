{{define "content"}}
{{template "admin_nav" .}}

<section class="admin-page-head">
  <div class="admin-page-head-main">
    <p class="admin-eyebrow">麦穗</p>
    <h1 class="admin-page-title">麦穗管理</h1>
    <p class="admin-subtitle">查询用户流水、调整麦穗、处理邀请与兑换单。所有写操作都会写入审计日志。</p>
  </div>
</section>

{{template "flash" .}}

<nav class="admin-filter-chips admin-points-tabs" aria-label="麦穗管理">
  {{range .Data.Tabs}}
  <a class="admin-chip-btn" href="/admin/points?tab={{.Value}}"{{if eq $.Data.Tab .Value}} aria-current="page"{{end}}>{{.Label}}</a>
  {{end}}
</nav>

{{if eq .Data.Tab "overview"}}
<section class="admin-stat-grid" aria-label="麦穗概况">
  <div class="admin-stat">
    <span class="admin-stat-icon" aria-hidden="true">{{template "admin_icon_wheat"}}</span>
    <span class="admin-stat-number">{{.Data.Stats.Earned}}</span>
    <span class="admin-stat-label">累计发放</span>
  </div>
  <div class="admin-stat">
    <span class="admin-stat-icon" aria-hidden="true">{{template "admin_icon_export"}}</span>
    <span class="admin-stat-number">{{.Data.Stats.Spent}}</span>
    <span class="admin-stat-label">累计消耗（兑换）</span>
  </div>
  <div class="admin-stat">
    <span class="admin-stat-icon" aria-hidden="true">{{template "admin_icon_check"}}</span>
    <span class="admin-stat-number">{{.Data.Stats.Balance}}</span>
    <span class="admin-stat-label">当前总余额</span>
  </div>
  <a class="admin-stat" href="/admin/points?tab=invites">
    <span class="admin-stat-icon" aria-hidden="true">{{template "admin_icon_users"}}</span>
    <span class="admin-stat-number{{if gt .Data.Stats.PendingInvites 0}} is-warn{{end}}">{{.Data.Stats.PendingInvites}}</span>
    <span class="admin-stat-label">待确认邀请</span>
    <span class="admin-stat-arrow" aria-hidden="true">›</span>
  </a>
  <a class="admin-stat" href="/admin/points?tab=redemptions&amp;status=pending">
    <span class="admin-stat-icon" aria-hidden="true">{{template "admin_icon_clock"}}</span>
    <span class="admin-stat-number{{if gt .Data.Stats.PendingRedemptions 0}} is-warn{{end}}">{{.Data.Stats.PendingRedemptions}}</span>
    <span class="admin-stat-label">待处理兑换</span>
    <span class="admin-stat-arrow" aria-hidden="true">›</span>
  </a>
  <a class="admin-stat" href="/admin/points?tab=redemptions&amp;status=active">
    <span class="admin-stat-icon" aria-hidden="true">{{template "admin_icon_check"}}</span>
    <span class="admin-stat-number">{{.Data.Stats.ActiveRedemptions}}</span>
    <span class="admin-stat-label">生效中兑换</span>
    <span class="admin-stat-arrow" aria-hidden="true">›</span>
  </a>
  <a class="admin-stat" href="/admin/points?tab=wishes">
    <span class="admin-stat-icon" aria-hidden="true">{{template "admin_icon_heart"}}</span>
    <span class="admin-stat-number">{{.Data.Stats.PendingWishes}}</span>
    <span class="admin-stat-label">心愿单待处理（共 {{.Data.Stats.WishTotal}}）</span>
    <span class="admin-stat-arrow" aria-hidden="true">›</span>
  </a>
  <a class="admin-stat" href="/admin/points?tab=recommendations">
    <span class="admin-stat-icon" aria-hidden="true">{{template "admin_icon_matching"}}</span>
    <span class="admin-stat-number">{{.Data.Stats.PendingRecommendations}}</span>
    <span class="admin-stat-label">推荐单待处理（共 {{.Data.Stats.MatchmakerTotal}}）</span>
    <span class="admin-stat-arrow" aria-hidden="true">›</span>
  </a>
</section>

<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">最近流水</h2>
      <p class="admin-section-desc">最新的 {{len .Data.RecentLedger}} 条麦穗变动。</p>
    </div>
    <a class="admin-section-meta" href="/admin/points?tab=ledger">查看全部 ›</a>
  </div>
  {{if .Data.RecentLedger}}
  <div class="admin-record-list">
    {{range .Data.RecentLedger}}
    <article class="admin-record">
      <span class="admin-avatar" aria-hidden="true">{{template "admin_icon_wheat"}}</span>
      <div class="admin-record-main">
        <h3 class="admin-record-title">
          <a href="/admin/users/{{.UserID}}">{{.UserName}}</a>
          {{if gt .Delta 0}}<span class="admin-chip admin-chip--done">+{{.Delta}}</span>{{else}}<span class="admin-chip admin-chip--cancel">{{.Delta}}</span>{{end}}
          <span class="admin-chip admin-chip--muted">{{.KindLabel}}</span>
        </h3>
        <p class="admin-record-sub">
          {{.CreatedAt.Format "2006-01-02 15:04"}} · 余额 {{.BalanceAfter}}
          {{if .LegacyUserID}} · <code>{{.LegacyUserID}}</code>{{end}}
        </p>
        {{if .Reason}}<p class="admin-record-sub">{{.Reason}}</p>{{end}}
      </div>
    </article>
    {{end}}
  </div>
  {{else}}
  <div class="admin-empty">
    <span class="admin-empty-icon" aria-hidden="true">{{template "admin_icon_wheat"}}</span>
    <h2 class="admin-empty-title">还没有麦穗流水</h2>
    <p>邀请到账或管理员调整后，这里会显示记录。</p>
  </div>
  {{end}}
</section>

<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">最近兑换</h2>
      <p class="admin-section-desc">最新 {{len .Data.RecentRedemptions}} 条兑换单。</p>
    </div>
    <a class="admin-section-meta" href="/admin/points?tab=redemptions">查看全部 ›</a>
  </div>
  {{if .Data.RecentRedemptions}}
  <div class="admin-record-list">
    {{range .Data.RecentRedemptions}}
    <article class="admin-record">
      <span class="admin-avatar" aria-hidden="true">{{template "admin_icon_wheat"}}</span>
      <div class="admin-record-main">
        <h3 class="admin-record-title">
          <a href="/admin/users/{{.UserID}}">{{.UserName}}</a>
          <span class="admin-chip admin-chip--full">{{.ItemLabel}}</span>
          {{template "admin_redemption_status_label" .StatusLabel}}
        </h3>
        <p class="admin-record-sub">{{.CreatedAt.Format "2006-01-02 15:04"}} · 花费 {{.Cost}} 穗{{if .UserLegacyID}} · <code>{{.UserLegacyID}}</code>{{end}}</p>
      </div>
    </article>
    {{end}}
  </div>
  {{else}}
  <p class="hint">还没有兑换单。</p>
  {{end}}
</section>

<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">待处理兑换</h2>
      <p class="admin-section-desc">待处理与生效中的兑换单，进入对应清单处理。</p>
    </div>
    <span class="admin-section-meta">{{len .Data.PendingRedemptions}} 单</span>
  </div>
  {{if .Data.PendingRedemptions}}
  <div class="admin-record-list">
    {{range .Data.PendingRedemptions}}
    <article class="admin-record">
      <div class="admin-record-main">
        <h3 class="admin-record-title">
          <a href="/admin/users/{{.UserID}}">{{.UserName}}</a>
          <span class="admin-chip admin-chip--full">{{.ItemLabel}}</span>
          {{template "admin_redemption_status_label" .StatusLabel}}
        </h3>
        <p class="admin-record-sub">{{.CreatedAt.Format "2006-01-02 15:04"}} · 花费 {{.Cost}} 穗</p>
      </div>
      <div class="admin-record-actions">
        <a class="button small" href="/admin/points?tab={{if eq .Item "wish"}}wishes{{else if eq .Item "matchmaker"}}recommendations{{else}}redemptions{{end}}">查看</a>
      </div>
    </article>
    {{end}}
  </div>
  {{else}}
  <p class="hint">没有待处理兑换。</p>
  {{end}}
</section>
{{end}}

{{if eq .Data.Tab "users"}}
<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">用户查询</h2>
      <p class="admin-section-desc">未输入关键字时，列出最近有麦穗流水或调整的用户，最多 50 人。</p>
    </div>
  </div>
  <form method="get" action="/admin/points" class="admin-filter-bar admin-filter-bar--inline" role="search">
    <input type="hidden" name="tab" value="users">
    <label class="admin-visually-hidden" for="points-user-q">搜寻用户</label>
    <span class="admin-search">
      {{template "admin_icon_search"}}
      <input id="points-user-q" class="admin-input" name="q" type="search" value="{{.Data.Query}}" placeholder="姓名、昵称、手机或会员编号">
    </span>
    <span></span>
    <button type="submit" class="button primary">查询</button>
  </form>

  {{if .Data.Users}}
  <div class="admin-record-list">
    {{range .Data.Users}}
    <article class="admin-record">
      <span class="admin-avatar" aria-hidden="true">{{template "admin_icon_users"}}</span>
      <div class="admin-record-main">
        <h3 class="admin-record-title">
          <a href="/admin/points?tab=users&amp;user_id={{.ID}}">{{.Name}}</a>
          {{if lt .Balance 0}}<span class="admin-chip admin-chip--cancel">{{.Balance}} 穗</span>{{else}}<span class="admin-chip admin-chip--open">{{.Balance}} 穗</span>{{end}}
        </h3>
        <p class="admin-record-sub">
          {{if .Nickname}}{{.Nickname}} · {{end}}<code>{{if .LegacyUserID}}{{.LegacyUserID}}{{else}}#{{.ID}}{{end}}</code>
          · {{if .PhoneMasked}}{{.PhoneMasked}}{{else}}无手机号{{end}}
        </p>
        <div class="admin-record-meta">
          <span class="admin-chip admin-chip--muted">{{.StatusLabel}}</span>
        </div>
      </div>
      <div class="admin-record-actions">
        <a class="button small primary" href="/admin/points?tab=users&amp;user_id={{.ID}}">调整/流水</a>
        <a class="button small" href="/admin/users/{{.ID}}">用户资料</a>
      </div>
    </article>
    {{end}}
  </div>
  {{else}}
  <div class="admin-empty">
    <span class="admin-empty-icon" aria-hidden="true">{{template "admin_icon_users"}}</span>
    <h2 class="admin-empty-title">没有符合条件的用户</h2>
    <p>换姓名、手机或会员编号再试。</p>
  </div>
  {{end}}
</section>

{{if .Data.SelectedMessage}}
<p class="admin-alert admin-alert--error" role="alert">{{.Data.SelectedMessage}}</p>
{{end}}

{{with .Data.Selected}}
<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">当前用户：{{.Name}}</h2>
      <p class="admin-section-desc">
        当前余额 <strong class="admin-points-number">{{.Balance}}</strong> 穗 · 状态 {{.StatusLabel}}
        {{if .LegacyUserID}} · <code>{{.LegacyUserID}}</code>{{end}}
      </p>
    </div>
    <a class="button small" href="/admin/users/{{.ID}}">用户资料</a>
  </div>

  <form method="post" action="/admin/points/adjust" class="admin-form-grid admin-points-adjust">
    <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
    <input type="hidden" name="user_id" value="{{.ID}}">
    <input type="hidden" name="q" value="{{$.Data.Query}}">
    <input type="hidden" name="op_key" value="{{$.Data.AdjustKey}}">
    <div class="admin-field">
      <label class="admin-field-label" for="points-adjust-delta">调整数量（正数加穗，负数减穗）</label>
      <input id="points-adjust-delta" class="admin-input" type="number" name="delta" step="1" required placeholder="例如 20 或 -10">
    </div>
    <div class="admin-field admin-form-span">
      <label class="admin-field-label" for="points-adjust-reason">原因（必填）</label>
      <textarea id="points-adjust-reason" class="admin-textarea" name="reason" maxlength="500" rows="3" required placeholder="说明本次调整的原因"></textarea>
    </div>
    <div class="admin-form-actions">
      <button type="submit" class="button primary" data-adm-confirm="确认调整 {{.Name}} 的麦穗？操作会写入审计日志。">提交调整</button>
    </div>
  </form>
</section>

<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">该用户最近流水</h2>
    </div>
    <span class="admin-section-meta">{{len $.Data.SelectedEntries}} 条</span>
  </div>
  {{if $.Data.SelectedEntries}}
  <div class="admin-record-list">
    {{range $.Data.SelectedEntries}}
    <article class="admin-record">
      <div class="admin-record-main">
        <h3 class="admin-record-title">
          {{.KindLabel}}
          {{if gt .Delta 0}}<span class="admin-chip admin-chip--done">+{{.Delta}}</span>{{else}}<span class="admin-chip admin-chip--cancel">{{.Delta}}</span>{{end}}
        </h3>
        <p class="admin-record-sub">{{.CreatedAt.Format "2006-01-02 15:04"}} · 余额后 {{.BalanceAfter}}{{if .Reason}} · {{.Reason}}{{end}}</p>
      </div>
    </article>
    {{end}}
  </div>
  {{else}}
  <p class="hint">该用户还没有麦穗流水。</p>
  {{end}}
</section>
{{end}}
{{end}}

{{if eq .Data.Tab "ledger"}}
<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">全站流水</h2>
      <p class="admin-section-desc">按用户、用户 ID 与类型筛选，每页 50 条。</p>
    </div>
  </div>
  <form method="get" action="/admin/points" class="admin-form-grid">
    <input type="hidden" name="tab" value="ledger">
    <div class="admin-field">
      <label class="admin-field-label" for="ledger-q">用户</label>
      <input id="ledger-q" class="admin-input" name="q" type="search" value="{{.Data.LedgerQuery}}" placeholder="ID/姓名/会员编号/手机">
    </div>
    <div class="admin-field">
      <label class="admin-field-label" for="ledger-user-id">用户 ID</label>
      <input id="ledger-user-id" class="admin-input" name="user_id" type="number" min="1" step="1" value="{{.Data.LedgerUserID}}" placeholder="精确用户 ID">
    </div>
    <div class="admin-field">
      <label class="admin-field-label" for="ledger-kind">类型</label>
      <select id="ledger-kind" class="admin-select" name="kind">
        {{range .Data.LedgerKinds}}
        <option value="{{.Value}}"{{if eq $.Data.LedgerKind .Value}} selected{{end}}>{{.Label}}</option>
        {{end}}
      </select>
    </div>
    <div class="admin-form-actions">
      <button type="submit" class="button primary">筛选</button>
      <a class="button" href="/admin/points?tab=ledger">重置</a>
    </div>
  </form>

  {{if .Data.Ledger}}
  <div class="admin-record-list">
    {{range .Data.Ledger}}
    <article class="admin-record">
      <div class="admin-record-main">
        <h3 class="admin-record-title">
          <a href="/admin/users/{{.UserID}}">{{.UserName}}</a>
          <span class="admin-chip admin-chip--muted">{{.KindLabel}}</span>
          {{if gt .Delta 0}}<span class="admin-chip admin-chip--done">+{{.Delta}}</span>{{else}}<span class="admin-chip admin-chip--cancel">{{.Delta}}</span>{{end}}
        </h3>
        <p class="admin-record-sub">
          {{.CreatedAt.Format "2006-01-02 15:04"}} · 余额后 {{.BalanceAfter}}
          {{if .LegacyUserID}} · <code>{{.LegacyUserID}}</code>{{end}}
          {{if .OperatorName}} · 操作人 {{.OperatorName}}{{end}}
        </p>
        {{if .Reason}}<p class="admin-record-sub">{{.Reason}}</p>{{end}}
      </div>
    </article>
    {{end}}
  </div>
  <nav class="admin-pagination" aria-label="流水分页">
    {{if .Data.LedgerPrevURL}}<a class="button small" href="{{.Data.LedgerPrevURL}}">上一页</a>{{end}}
    <span class="hint">第 {{.Data.LedgerPage}} 页</span>
    {{if .Data.LedgerNextURL}}<a class="button small" href="{{.Data.LedgerNextURL}}">下一页</a>{{end}}
  </nav>
  {{else}}
  <div class="admin-empty">
    <span class="admin-empty-icon" aria-hidden="true">{{template "admin_icon_wheat"}}</span>
    <h2 class="admin-empty-title">没有符合条件的流水</h2>
    <p>调整筛选条件再试。</p>
  </div>
  {{end}}
</section>
{{end}}

{{if eq .Data.Tab "invites"}}
<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">邀请记录</h2>
      <p class="admin-section-desc">邀请到账、收回与无效都会影响麦穗账本。</p>
    </div>
    <span class="admin-section-meta">共 {{.Data.InviteCounts.Total}} 条</span>
  </div>
  <p class="admin-counts">
    <span>待确认 <strong>{{.Data.InviteCounts.Awaiting}}</strong></span>
    <span>已到账 <strong>{{.Data.InviteCounts.Finalized}}</strong></span>
    <span>已收回 <strong>{{.Data.InviteCounts.ClawedBack}}</strong></span>
    <span>无效 <strong>{{.Data.InviteCounts.Rejected}}</strong></span>
    <span>全部 <strong>{{.Data.InviteCounts.Total}}</strong></span>
  </p>
  <form method="get" action="/admin/points" class="admin-filter-bar admin-filter-bar--inline">
    <input type="hidden" name="tab" value="invites">
    <label class="admin-visually-hidden" for="invite-status">状态</label>
    <select id="invite-status" class="admin-select" name="status">
      {{range .Data.InviteStatuses}}
      <option value="{{.Value}}"{{if eq $.Data.InviteStatus .Value}} selected{{end}}>{{.Label}}</option>
      {{end}}
    </select>
    <span></span>
    <button type="submit" class="button primary">筛选</button>
  </form>

  {{if .Data.Invites}}
  <div class="admin-record-list">
    {{range .Data.Invites}}
    <article class="admin-record">
      <span class="admin-avatar" aria-hidden="true">{{template "admin_icon_users"}}</span>
      <div class="admin-record-main">
        <h3 class="admin-record-title">
          <a href="/admin/users/{{.InviterID}}">{{.InviterName}}</a>
          {{template "admin_invite_status" .StatusLabel}}
          {{if .Reward}}<span class="admin-chip admin-chip--done">+{{.Reward}} 穗</span>{{end}}
        </h3>
        <p class="admin-record-sub">
          {{if .PhoneMasked}}{{.PhoneMasked}}{{else}}无手机号{{end}} · 建立 {{.CreatedAt.Format "2006-01-02 15:04"}}
          {{if .InviterLegacyID}} · <code>{{.InviterLegacyID}}</code>{{end}}
        </p>
        {{if or .ConfirmDueAt .ConfirmedAt}}
        <p class="admin-record-sub">
          {{if .ConfirmDueAt}}到期 {{.ConfirmDueAt.Format "2006-01-02 15:04"}}{{end}}
          {{if .ConfirmedAt}} · 确认 {{.ConfirmedAt.Format "2006-01-02 15:04"}}{{end}}
        </p>
        {{end}}
      </div>
    </article>
    {{end}}
  </div>
  {{else}}
  <div class="admin-empty">
    <span class="admin-empty-icon" aria-hidden="true">{{template "admin_icon_users"}}</span>
    <h2 class="admin-empty-title">没有符合条件的邀请记录</h2>
    <p>换个状态再试。</p>
  </div>
  {{end}}
</section>
{{end}}

{{if eq .Data.Tab "redemptions"}}
<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">兑换单</h2>
      <p class="admin-section-desc">退穗会把麦穗退回用户账户；更新状态只改兑换单。</p>
    </div>
  </div>
  <form method="get" action="/admin/points" class="admin-form-grid">
    <input type="hidden" name="tab" value="redemptions">
    <div class="admin-field">
      <label class="admin-field-label" for="redeem-item">项目</label>
      <select id="redeem-item" class="admin-select" name="item">
        {{range .Data.ItemOptions}}
        <option value="{{.Value}}"{{if eq $.Data.ItemFilter .Value}} selected{{end}}>{{.Label}}</option>
        {{end}}
      </select>
    </div>
    <div class="admin-field">
      <label class="admin-field-label" for="redeem-status">状态</label>
      <select id="redeem-status" class="admin-select" name="status">
        {{range .Data.StatusOptions}}
        <option value="{{.Value}}"{{if eq $.Data.StatusFilter .Value}} selected{{end}}>{{.Label}}</option>
        {{end}}
      </select>
    </div>
    <div class="admin-form-actions">
      <button type="submit" class="button primary">筛选</button>
      <a class="button" href="/admin/points?tab=redemptions">重置</a>
    </div>
  </form>

  {{if .Data.Redemptions}}
  <div class="admin-record-list">
    {{range .Data.Redemptions}}
    <article class="admin-record">
      <div class="admin-record-main">
        <h3 class="admin-record-title">
          <a href="/admin/users/{{.UserID}}">{{.UserName}}</a>
          <span class="admin-chip admin-chip--full">{{.ItemLabel}}</span>
          {{template "admin_redemption_status_label" .StatusLabel}}
          <span class="admin-chip admin-chip--muted">{{.Cost}} 穗</span>
        </h3>
        <p class="admin-record-sub">
          {{.CreatedAt.Format "2006-01-02 15:04"}}{{if .UserLegacyID}} · <code>{{.UserLegacyID}}</code>{{end}}
        </p>
        <div class="admin-record-meta">
          {{if eq .Item "wish"}}
            {{if .ActivityTitle}}<span class="admin-chip admin-chip--muted">活动：{{.ActivityTitle}}</span>{{end}}
            {{if .TargetUserID}}<span class="admin-chip admin-chip--muted">心愿对象：{{if .TargetName}}{{.TargetName}}{{else}}#{{.TargetUserID}}{{end}}</span>{{end}}
          {{else if eq .Item "matchmaker"}}
            {{if .Condition}}<span class="admin-chip admin-chip--muted">条件：{{.Condition}}</span>{{end}}
          {{else if eq .Item "priority_signup"}}
            {{if .ActivityTitle}}<span class="admin-chip admin-chip--muted">活动：{{.ActivityTitle}}</span>{{end}}
          {{else if eq .Item "real_like"}}
            <span class="admin-chip admin-chip--muted">额外实名喜欢</span>
          {{end}}
          {{if .Note}}<span class="admin-chip admin-chip--muted">备注：{{.Note}}</span>{{end}}
        </div>
      </div>
      <div class="admin-record-actions admin-points-actions">
        {{if .CanRefund}}
        <form method="post" action="/admin/points/redemptions/{{.ID}}/refund" class="admin-points-action">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <input type="hidden" name="tab" value="{{$.Data.Tab}}">
          <input class="admin-input" name="reason" type="text" maxlength="200" placeholder="退穗原因（可选）" aria-label="退穗原因">
          <button type="submit" class="button small danger" data-adm-confirm="确认退穗？麦穗会退回用户账户。">退穗</button>
        </form>
        {{end}}
        {{if .CanMark}}
        <form method="post" action="/admin/points/redemptions/{{.ID}}/mark" class="admin-points-action">
          <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
          <input type="hidden" name="tab" value="{{$.Data.Tab}}">
          <select class="admin-select" name="status" aria-label="新状态">
            {{range .MarkOptions}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
          </select>
          <input class="admin-input" name="note" type="text" maxlength="200" placeholder="备注（可选）" aria-label="状态备注">
          <button type="submit" class="button small">更新状态</button>
        </form>
        {{end}}
        {{if and (not .CanRefund) (not .CanMark)}}<span class="admin-chip admin-chip--muted">已处理</span>{{end}}
      </div>
    </article>
    {{end}}
  </div>
  <nav class="admin-pagination" aria-label="兑换分页">
    {{if .Data.PrevURL}}<a class="button small" href="{{.Data.PrevURL}}">上一页</a>{{end}}
    <span class="hint">第 {{.Data.Page}} 页</span>
    {{if .Data.NextURL}}<a class="button small" href="{{.Data.NextURL}}">下一页</a>{{end}}
  </nav>
  {{else}}
  <div class="admin-empty">
    <span class="admin-empty-icon" aria-hidden="true">{{template "admin_icon_wheat"}}</span>
    <h2 class="admin-empty-title">没有符合条件的兑换单</h2>
    <p>换个项目或状态再试。</p>
  </div>
  {{end}}
</section>
{{end}}

