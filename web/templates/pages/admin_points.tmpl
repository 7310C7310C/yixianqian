{{define "content"}}
{{template "admin_nav" .}}

<section class="card">
  <div class="admin-title-row">
    <div>
      <p class="eyebrow">麦穗</p>
      <h1>麦穗管理</h1>
      <p class="hint">查询用户流水、调整麦穗、处理邀请与兑换单。所有写操作都会写入审计日志。</p>
    </div>
  </div>
  {{template "flash" .}}
  <nav class="admin-tabs admin-points-tabs" aria-label="麦穗管理">
    {{range .Data.Tabs}}
    <a href="/admin/points?tab={{.Value}}"{{if eq $.Data.Tab .Value}} aria-current="page"{{end}}>{{.Label}}</a>
    {{end}}
  </nav>
</section>

{{if eq .Data.Tab "overview"}}
<section class="card">
  <h2>麦穗概况</h2>
  <div class="admin-stat-grid">
    <div class="admin-stat">
      <span class="admin-stat-number">{{.Data.Stats.Earned}}</span>
      <span class="admin-stat-label">累计发放</span>
    </div>
    <div class="admin-stat">
      <span class="admin-stat-number">{{.Data.Stats.Spent}}</span>
      <span class="admin-stat-label">累计消耗（兑换）</span>
    </div>
    <div class="admin-stat">
      <span class="admin-stat-number">{{.Data.Stats.Balance}}</span>
      <span class="admin-stat-label">当前总余额</span>
    </div>
    <a class="admin-stat" href="/admin/points?tab=invites">
      <span class="admin-stat-number">{{.Data.Stats.PendingInvites}}</span>
      <span class="admin-stat-label">待确认邀请</span>
    </a>
    <a class="admin-stat" href="/admin/points?tab=redemptions&amp;status=pending">
      <span class="admin-stat-number">{{.Data.Stats.PendingRedemptions}}</span>
      <span class="admin-stat-label">待处理兑换</span>
    </a>
    <a class="admin-stat" href="/admin/points?tab=redemptions&amp;status=active">
      <span class="admin-stat-number">{{.Data.Stats.ActiveRedemptions}}</span>
      <span class="admin-stat-label">生效中兑换</span>
    </a>
    <a class="admin-stat" href="/admin/points?tab=wishes">
      <span class="admin-stat-number">{{.Data.Stats.PendingWishes}}</span>
      <span class="admin-stat-label">心愿单待处理（共 {{.Data.Stats.WishTotal}}）</span>
    </a>
    <a class="admin-stat" href="/admin/points?tab=recommendations">
      <span class="admin-stat-number">{{.Data.Stats.PendingRecommendations}}</span>
      <span class="admin-stat-label">推荐单待处理（共 {{.Data.Stats.MatchmakerTotal}}）</span>
    </a>
  </div>
</section>

<section class="card">
  <h2>最近流水</h2>
  {{if .Data.RecentLedger}}
  <div class="admin-table-wrap">
    <table class="admin-table admin-points-table">
      <thead>
        <tr>
          <th scope="col">时间</th>
          <th scope="col">用户</th>
          <th scope="col">类型</th>
          <th scope="col">增减</th>
          <th scope="col">余额</th>
          <th scope="col">原因</th>
        </tr>
      </thead>
      <tbody>
        {{range .Data.RecentLedger}}
        <tr>
          <td data-label="时间"><time class="muted">{{.CreatedAt.Format "2006-01-02 15:04"}}</time></td>
          <td data-label="用户">
            <a href="/admin/users/{{.UserID}}">{{.UserName}}</a>
            {{if .LegacyUserID}}<div class="muted"><code>{{.LegacyUserID}}</code></div>{{end}}
          </td>
          <td data-label="类型">{{.KindLabel}}</td>
          <td data-label="增减" class="admin-points-number">
            {{if gt .Delta 0}}<span class="admin-points-delta-pos">+{{.Delta}}</span>{{else}}<span class="admin-points-delta-neg">{{.Delta}}</span>{{end}}
          </td>
          <td data-label="余额" class="admin-points-number">{{.BalanceAfter}}</td>
          <td data-label="原因">{{if .Reason}}{{.Reason}}{{else}}<span class="muted">—</span>{{end}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="muted">还没有麦穗流水。</p>
  {{end}}
</section>

<section class="card">
  <h2>最近兑换</h2>
  {{if .Data.RecentRedemptions}}
  <div class="admin-table-wrap">
    <table class="admin-table admin-points-table">
      <thead>
        <tr>
          <th scope="col">时间</th>
          <th scope="col">用户</th>
          <th scope="col">项目</th>
          <th scope="col">花费</th>
          <th scope="col">状态</th>
        </tr>
      </thead>
      <tbody>
        {{range .Data.RecentRedemptions}}
        <tr>
          <td data-label="时间"><time class="muted">{{.CreatedAt.Format "2006-01-02 15:04"}}</time></td>
          <td data-label="用户">
            <a href="/admin/users/{{.UserID}}">{{.UserName}}</a>
            {{if .UserLegacyID}}<div class="muted"><code>{{.UserLegacyID}}</code></div>{{end}}
          </td>
          <td data-label="项目"><span class="pill">{{.ItemLabel}}</span></td>
          <td data-label="花费" class="admin-points-number">{{.Cost}}</td>
          <td data-label="状态">{{.StatusLabel}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="muted">还没有兑换单。</p>
  {{end}}
</section>

<section class="card">
  <h2>待处理兑换摘要</h2>
  {{if .Data.PendingRedemptions}}
  <div class="admin-table-wrap">
    <table class="admin-table admin-points-table">
      <thead>
        <tr>
          <th scope="col">时间</th>
          <th scope="col">用户</th>
          <th scope="col">项目</th>
          <th scope="col">状态</th>
          <th scope="col">处理</th>
        </tr>
      </thead>
      <tbody>
        {{range .Data.PendingRedemptions}}
        <tr>
          <td data-label="时间"><time class="muted">{{.CreatedAt.Format "2006-01-02 15:04"}}</time></td>
          <td data-label="用户">
            <a href="/admin/users/{{.UserID}}">{{.UserName}}</a>
            {{if .UserLegacyID}}<div class="muted"><code>{{.UserLegacyID}}</code></div>{{end}}
          </td>
          <td data-label="项目"><span class="pill">{{.ItemLabel}}</span></td>
          <td data-label="状态">{{.StatusLabel}}</td>
          <td data-label="处理">
            <a class="button small" href="/admin/points?tab={{if eq .Item "wish"}}wishes{{else if eq .Item "matchmaker"}}recommendations{{else}}redemptions{{end}}">查看</a>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="muted">没有待处理兑换。</p>
  {{end}}
</section>
{{end}}

{{if eq .Data.Tab "users"}}
<section class="card">
  <h2>用户查询</h2>
  <form method="get" action="/admin/points" class="admin-points-filters">
    <input type="hidden" name="tab" value="users">
    <label>搜寻
      <input name="q" type="search" value="{{.Data.Query}}" placeholder="姓名、昵称、手机或会员编号">
    </label>
    <button type="submit" class="button primary">查询</button>
  </form>
  <p class="hint">未输入关键字时，列出最近有麦穗流水或调整的用户，最多 50 人。</p>

  {{if .Data.Users}}
  <div class="admin-table-wrap">
    <table class="admin-table admin-points-table">
      <thead>
        <tr>
          <th scope="col">会员</th>
          <th scope="col">手机</th>
          <th scope="col">余额</th>
          <th scope="col">状态</th>
          <th scope="col">操作</th>
        </tr>
      </thead>
      <tbody>
        {{range .Data.Users}}
        <tr>
          <td data-label="会员">
            <strong>{{.Name}}</strong>
            {{if .Nickname}}<span class="muted">（{{.Nickname}}）</span>{{end}}
            <div class="muted"><code>{{if .LegacyUserID}}{{.LegacyUserID}}{{else}}#{{.ID}}{{end}}</code></div>
          </td>
          <td data-label="手机">{{if .PhoneMasked}}{{.PhoneMasked}}{{else}}<span class="muted">—</span>{{end}}</td>
          <td data-label="余额" class="admin-points-number">{{.Balance}}</td>
          <td data-label="状态"><span class="pill">{{.StatusLabel}}</span></td>
          <td data-label="操作">
            <div class="admin-actions">
              <a class="button small" href="/admin/points?tab=users&amp;user_id={{.ID}}">调整/流水</a>
              <a class="button small" href="/admin/users/{{.ID}}">用户资料</a>
            </div>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="muted">没有符合条件的用户。</p>
  {{end}}
</section>

{{if .Data.SelectedMessage}}
<div class="alert alert-error" role="alert">{{.Data.SelectedMessage}}</div>
{{end}}

{{with .Data.Selected}}
<section class="card">
  <div class="admin-title-row">
    <div>
      <h2>当前用户：{{.Name}}</h2>
      <p class="hint">
        当前余额 <strong class="admin-points-number">{{.Balance}}</strong> 穗 ·
        状态 <span class="pill">{{.StatusLabel}}</span>
        {{if .LegacyUserID}} · <code>{{.LegacyUserID}}</code>{{end}}
      </p>
    </div>
    <div class="admin-actions">
      <a class="button small" href="/admin/users/{{.ID}}">用户资料</a>
    </div>
  </div>

  <form method="post" action="/admin/points/adjust" class="admin-points-form">
    <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
    <input type="hidden" name="user_id" value="{{.ID}}">
    <input type="hidden" name="q" value="{{$.Data.Query}}">
    <input type="hidden" name="op_key" value="{{$.Data.AdjustKey}}">
    <label>调整数量（正数加穗，负数减穗）
      <input type="number" name="delta" step="1" required placeholder="例如 20 或 -10">
    </label>
    <label>原因（必填）
      <textarea name="reason" maxlength="500" rows="3" required placeholder="说明本次调整的原因"></textarea>
    </label>
    <div class="admin-actions">
      <button type="submit" class="button primary">提交调整</button>
    </div>
  </form>
</section>

<section class="card">
  <h2>该用户最近流水</h2>
  {{if $.Data.SelectedEntries}}
  <div class="admin-table-wrap">
    <table class="admin-table admin-points-table">
      <thead>
        <tr>
          <th scope="col">时间</th>
          <th scope="col">类型</th>
          <th scope="col">增减</th>
          <th scope="col">余额后</th>
          <th scope="col">原因</th>
        </tr>
      </thead>
      <tbody>
        {{range $.Data.SelectedEntries}}
        <tr>
          <td data-label="时间"><time class="muted">{{.CreatedAt.Format "2006-01-02 15:04"}}</time></td>
          <td data-label="类型">{{.KindLabel}}</td>
          <td data-label="增减" class="admin-points-number">
            {{if gt .Delta 0}}<span class="admin-points-delta-pos">+{{.Delta}}</span>{{else}}<span class="admin-points-delta-neg">{{.Delta}}</span>{{end}}
          </td>
          <td data-label="余额后" class="admin-points-number">{{.BalanceAfter}}</td>
          <td data-label="原因">{{if .Reason}}{{.Reason}}{{else}}<span class="muted">—</span>{{end}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="muted">该用户还没有麦穗流水。</p>
  {{end}}
</section>
{{end}}
{{end}}

{{if eq .Data.Tab "ledger"}}
<section class="card">
  <h2>全站流水</h2>
  <form method="get" action="/admin/points" class="admin-points-filters">
    <input type="hidden" name="tab" value="ledger">
    <label>用户（ID/姓名/会员编号/手机）
      <input name="q" type="search" value="{{.Data.LedgerQuery}}" placeholder="搜寻用户">
    </label>
    <label>用户 ID
      <input name="user_id" type="number" min="1" step="1" value="{{.Data.LedgerUserID}}" placeholder="精确用户 ID">
    </label>
    <label>类型
      <select name="kind">
        {{range .Data.LedgerKinds}}
        <option value="{{.Value}}"{{if eq $.Data.LedgerKind .Value}} selected{{end}}>{{.Label}}</option>
        {{end}}
      </select>
    </label>
    <button type="submit" class="button primary">筛选</button>
  </form>

  {{if .Data.Ledger}}
  <div class="admin-table-wrap">
    <table class="admin-table admin-points-table">
      <thead>
        <tr>
          <th scope="col">时间</th>
          <th scope="col">用户</th>
          <th scope="col">类型</th>
          <th scope="col">增减</th>
          <th scope="col">余额后</th>
          <th scope="col">原因</th>
          <th scope="col">操作人</th>
        </tr>
      </thead>
      <tbody>
        {{range .Data.Ledger}}
        <tr>
          <td data-label="时间"><time class="muted">{{.CreatedAt.Format "2006-01-02 15:04"}}</time></td>
          <td data-label="用户">
            <a href="/admin/users/{{.UserID}}">{{.UserName}}</a>
            {{if .LegacyUserID}}<div class="muted"><code>{{.LegacyUserID}}</code></div>{{end}}
          </td>
          <td data-label="类型">{{.KindLabel}}</td>
          <td data-label="增减" class="admin-points-number">
            {{if gt .Delta 0}}<span class="admin-points-delta-pos">+{{.Delta}}</span>{{else}}<span class="admin-points-delta-neg">{{.Delta}}</span>{{end}}
          </td>
          <td data-label="余额后" class="admin-points-number">{{.BalanceAfter}}</td>
          <td data-label="原因">{{if .Reason}}{{.Reason}}{{else}}<span class="muted">—</span>{{end}}</td>
          <td data-label="操作人">{{if .OperatorName}}{{.OperatorName}}{{else}}<span class="muted">—</span>{{end}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  <nav class="admin-pagination" aria-label="流水分页">
    {{if .Data.LedgerPrevURL}}<a class="button small" href="{{.Data.LedgerPrevURL}}">上一页</a>{{end}}
    <span class="muted">第 {{.Data.LedgerPage}} 页</span>
    {{if .Data.LedgerNextURL}}<a class="button small" href="{{.Data.LedgerNextURL}}">下一页</a>{{end}}
  </nav>
  {{else}}
  <p class="muted">没有符合条件的流水。</p>
  {{end}}
</section>
{{end}}

{{if eq .Data.Tab "invites"}}
<section class="card">
  <h2>邀请记录</h2>
  <div class="admin-counts">
    <span>待确认 <strong>{{.Data.InviteCounts.Awaiting}}</strong></span>
    <span>已到账 <strong>{{.Data.InviteCounts.Finalized}}</strong></span>
    <span>已收回 <strong>{{.Data.InviteCounts.ClawedBack}}</strong></span>
    <span>无效 <strong>{{.Data.InviteCounts.Rejected}}</strong></span>
    <span>全部 <strong>{{.Data.InviteCounts.Total}}</strong></span>
  </div>
  <form method="get" action="/admin/points" class="admin-points-filters">
    <input type="hidden" name="tab" value="invites">
    <label>状态
      <select name="status">
        {{range .Data.InviteStatuses}}
        <option value="{{.Value}}"{{if eq $.Data.InviteStatus .Value}} selected{{end}}>{{.Label}}</option>
        {{end}}
      </select>
    </label>
    <button type="submit" class="button primary">筛选</button>
  </form>

  {{if .Data.Invites}}
  <div class="admin-table-wrap">
    <table class="admin-table admin-points-table">
      <thead>
        <tr>
          <th scope="col">邀请人</th>
          <th scope="col">手机</th>
          <th scope="col">状态</th>
          <th scope="col">奖励穗数</th>
          <th scope="col">建立时间</th>
          <th scope="col">到期 / 确认时间</th>
        </tr>
      </thead>
      <tbody>
        {{range .Data.Invites}}
        <tr>
          <td data-label="邀请人">
            <a href="/admin/users/{{.InviterID}}">{{.InviterName}}</a>
            {{if .InviterLegacyID}}<div class="muted"><code>{{.InviterLegacyID}}</code></div>{{end}}
          </td>
          <td data-label="手机" class="admin-points-number">{{if .PhoneMasked}}{{.PhoneMasked}}{{else}}<span class="muted">—</span>{{end}}</td>
          <td data-label="状态"><span class="pill">{{.StatusLabel}}</span></td>
          <td data-label="奖励穗数" class="admin-points-number">{{if .Reward}}{{.Reward}}{{else}}<span class="muted">—</span>{{end}}</td>
          <td data-label="建立时间"><time class="muted">{{.CreatedAt.Format "2006-01-02 15:04"}}</time></td>
          <td data-label="到期 / 确认时间">
            {{if .ConfirmDueAt}}<div>到期 {{.ConfirmDueAt.Format "2006-01-02 15:04"}}</div>{{end}}
            {{if .ConfirmedAt}}<div class="muted">确认 {{.ConfirmedAt.Format "2006-01-02 15:04"}}</div>{{end}}
            {{if and (not .ConfirmDueAt) (not .ConfirmedAt)}}<span class="muted">—</span>{{end}}
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="muted">没有符合条件的邀请记录。</p>
  {{end}}
</section>
{{end}}

{{if eq .Data.Tab "redemptions"}}
<section class="card">
  <h2>兑换单</h2>
  <form method="get" action="/admin/points" class="admin-points-filters">
    <input type="hidden" name="tab" value="redemptions">
    <label>项目
      <select name="item">
        {{range .Data.ItemOptions}}
        <option value="{{.Value}}"{{if eq $.Data.ItemFilter .Value}} selected{{end}}>{{.Label}}</option>
        {{end}}
      </select>
    </label>
    <label>状态
      <select name="status">
        {{range .Data.StatusOptions}}
        <option value="{{.Value}}"{{if eq $.Data.StatusFilter .Value}} selected{{end}}>{{.Label}}</option>
        {{end}}
      </select>
    </label>
    <button type="submit" class="button primary">筛选</button>
  </form>

  {{if .Data.Redemptions}}
  <div class="admin-table-wrap">
    <table class="admin-table admin-points-table">
      <thead>
        <tr>
          <th scope="col">用户</th>
          <th scope="col">项目</th>
          <th scope="col">花费</th>
          <th scope="col">状态</th>
          <th scope="col">摘要</th>
          <th scope="col">时间</th>
          <th scope="col">操作</th>
        </tr>
      </thead>
      <tbody>
        {{range .Data.Redemptions}}
        <tr>
          <td data-label="用户">
            <a href="/admin/users/{{.UserID}}">{{.UserName}}</a>
            {{if .UserLegacyID}}<div class="muted"><code>{{.UserLegacyID}}</code></div>{{end}}
          </td>
          <td data-label="项目"><span class="pill">{{.ItemLabel}}</span></td>
          <td data-label="花费" class="admin-points-number">{{.Cost}}</td>
          <td data-label="状态">{{.StatusLabel}}</td>
          <td data-label="摘要">
            {{if eq .Item "wish"}}
              {{if .ActivityTitle}}<div>活动：{{.ActivityTitle}}</div>{{end}}
              {{if .TargetUserID}}<div>心愿对象：<a href="/admin/users/{{.TargetUserID}}">{{if .TargetName}}{{.TargetName}}{{else}}#{{.TargetUserID}}{{end}}</a>{{if .TargetLegacy}} <code>{{.TargetLegacy}}</code>{{end}}</div>{{end}}
            {{else if eq .Item "matchmaker"}}
              {{if .Condition}}<div>条件：{{.Condition}}</div>{{end}}
            {{else if eq .Item "priority_signup"}}
              {{if .ActivityTitle}}<div>活动：{{.ActivityTitle}}</div>{{end}}
            {{else if eq .Item "real_like"}}
              <span class="muted">额外实名喜欢</span>
            {{end}}
            {{if .Note}}<div class="muted">备注：{{.Note}}</div>{{end}}
          </td>
          <td data-label="时间"><time class="muted">{{.CreatedAt.Format "2006-01-02 15:04"}}</time></td>
          <td data-label="操作">
            <div class="admin-points-actions">
              {{if .CanRefund}}
              <form method="post" action="/admin/points/redemptions/{{.ID}}/refund" class="admin-points-action">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <input type="hidden" name="tab" value="{{$.Data.Tab}}">
                <input name="reason" type="text" maxlength="200" placeholder="退穗原因（可选）" aria-label="退穗原因">
                <button type="submit" class="button small danger">退穗</button>
              </form>
              {{end}}
              {{if .CanMark}}
              <form method="post" action="/admin/points/redemptions/{{.ID}}/mark" class="admin-points-action">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <input type="hidden" name="tab" value="{{$.Data.Tab}}">
                <select name="status" aria-label="新状态">
                  {{range .MarkOptions}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
                </select>
                <input name="note" type="text" maxlength="200" placeholder="备注（可选）" aria-label="状态备注">
                <button type="submit" class="button small">更新状态</button>
              </form>
              {{end}}
              {{if and (not .CanRefund) (not .CanMark)}}<span class="muted">已处理</span>{{end}}
            </div>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  <nav class="admin-pagination" aria-label="兑换分页">
    {{if .Data.PrevURL}}<a class="button small" href="{{.Data.PrevURL}}">上一页</a>{{end}}
    <span class="muted">第 {{.Data.Page}} 页</span>
    {{if .Data.NextURL}}<a class="button small" href="{{.Data.NextURL}}">下一页</a>{{end}}
  </nav>
  {{else}}
  <p class="muted">没有符合条件的兑换单。</p>
  {{end}}
</section>
{{end}}

{{if eq .Data.Tab "wishes"}}
<section class="card">
  <h2>心愿单（心愿名额）</h2>
  <form method="get" action="/admin/points" class="admin-points-filters">
    <input type="hidden" name="tab" value="wishes">
    <label>状态
      <select name="status">
        {{range .Data.StatusOptions}}
        <option value="{{.Value}}"{{if eq $.Data.StatusFilter .Value}} selected{{end}}>{{.Label}}</option>
        {{end}}
      </select>
    </label>
    <button type="submit" class="button primary">筛选</button>
  </form>

  {{if .Data.Redemptions}}
  <div class="admin-table-wrap">
    <table class="admin-table admin-points-table">
      <thead>
        <tr>
          <th scope="col">用户</th>
          <th scope="col">活动</th>
          <th scope="col">心愿对象</th>
          <th scope="col">状态</th>
          <th scope="col">花费</th>
          <th scope="col">时间</th>
          <th scope="col">操作</th>
        </tr>
      </thead>
      <tbody>
        {{range .Data.Redemptions}}
        <tr>
          <td data-label="用户">
            <a href="/admin/users/{{.UserID}}">{{.UserName}}</a>
            {{if .UserLegacyID}}<div class="muted"><code>{{.UserLegacyID}}</code></div>{{end}}
          </td>
          <td data-label="活动">{{if .ActivityTitle}}{{.ActivityTitle}}{{else}}<span class="muted">—</span>{{end}}</td>
          <td data-label="心愿对象">
            {{if .TargetUserID}}
            <a href="/admin/users/{{.TargetUserID}}">{{if .TargetName}}{{.TargetName}}{{else}}#{{.TargetUserID}}{{end}}</a>
            {{if .TargetLegacy}}<div class="muted"><code>{{.TargetLegacy}}</code></div>{{end}}
            {{else}}<span class="muted">—</span>{{end}}
          </td>
          <td data-label="状态">{{.StatusLabel}}</td>
          <td data-label="花费" class="admin-points-number">{{.Cost}}</td>
          <td data-label="时间"><time class="muted">{{.CreatedAt.Format "2006-01-02 15:04"}}</time></td>
          <td data-label="操作">
            <div class="admin-points-actions">
              {{if .CanRefund}}
              <form method="post" action="/admin/points/redemptions/{{.ID}}/refund" class="admin-points-action">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <input type="hidden" name="tab" value="{{$.Data.Tab}}">
                <input name="reason" type="text" maxlength="200" placeholder="退穗原因（可选）" aria-label="退穗原因">
                <button type="submit" class="button small danger">退穗</button>
              </form>
              {{end}}
              {{if .CanMark}}
              <form method="post" action="/admin/points/redemptions/{{.ID}}/mark" class="admin-points-action">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <input type="hidden" name="tab" value="{{$.Data.Tab}}">
                <select name="status" aria-label="新状态">
                  {{range .MarkOptions}}<option value="{{.Value}}">{{.Label}}</option>{{end}}
                </select>
                <input name="note" type="text" maxlength="200" placeholder="备注（可选）" aria-label="状态备注">
                <button type="submit" class="button small">更新状态</button>
              </form>
              {{end}}
              {{if and (not .CanRefund) (not .CanMark)}}<span class="muted">已处理</span>{{end}}
            </div>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  <nav class="admin-pagination" aria-label="心愿单分页">
    {{if .Data.PrevURL}}<a class="button small" href="{{.Data.PrevURL}}">上一页</a>{{end}}
    <span class="muted">第 {{.Data.Page}} 页</span>
    {{if .Data.NextURL}}<a class="button small" href="{{.Data.NextURL}}">下一页</a>{{end}}
  </nav>
  {{else}}
  <p class="muted">没有符合条件的心愿单。</p>
  {{end}}
</section>
{{end}}

