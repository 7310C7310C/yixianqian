{{define "content"}}
<section class="card narrow">
  <h1 data-copy-text="activate.title"></h1>
  <p class="muted"><span data-copy-text="activate.leadBefore"></span><strong>{{.Data.NameHTML}}</strong><span data-copy-text="activate.leadAfter"></span>{{.Phone}}<span data-copy-text="activate.leadEnd"></span></p>
  {{if .Error}}<div class="alert alert-error" role="alert">{{.Error}}</div>{{end}}
  <form method="post" action="/activate" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <input type="hidden" name="token" value="{{.Token}}">
    <label for="password" data-copy-text="activate.newPassword"></label>
    <input id="password" name="password" type="password" autocomplete="new-password"
           minlength="8" maxlength="128" required autofocus>
    <label for="password_confirm" data-copy-text="activate.confirmPassword"></label>
    <input id="password_confirm" name="password_confirm" type="password"
           autocomplete="new-password" minlength="8" maxlength="128" required>
    <p class="hint" data-copy-text="activate.hint"></p>
    <button type="submit" class="button primary" data-copy-text="activate.submit"></button>
  </form>
</section>
{{end}}
