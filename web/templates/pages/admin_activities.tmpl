{{define "content"}}
{{template "admin_nav" .}}

<section class="card">
  <div class="admin-title-row">
    <div>
      <p class="eyebrow">活动</p>
      <h1>活动管理</h1>
      <p class="hint">共 {{len .Data.Activities}} 个活动；点「工作台」管理名单、签到、海报与广播。</p>
    </div>
  </div>
  {{template "flash" .}}
</section>

<section class="card">
  <h2>活动列表</h2>
  {{if .Data.Activities}}
  <div class="admin-table-wrap">
    <table class="admin-table admin-activities-table">
      <thead><tr><th scope="col">活动</th><th scope="col">状态</th><th scope="col">报名</th><th scope="col">签到</th><th scope="col">分组/一对一</th><th scope="col">操作</th></tr></thead>
      <tbody>
      {{range .Data.Activities}}
        <tr>
          <td data-label="活动">
            <div class="admin-activity-cell">
              {{if .PosterMediaID}}<img class="admin-thumb" src="/admin/activities/{{.ID}}/poster?size=thumb" alt="{{.Name}} 海报" loading="lazy">{{end}}
              <div>
                <strong>{{.Name}}</strong>
                <div class="muted"><code>{{.ActivityNo}}</code></div>
              </div>
            </div>
          </td>
          <td data-label="状态"><span class="pill">{{.Status}}</span></td>
          <td data-label="报名">{{.SignupCount}}{{if gt .MaxSignup 0}} / {{.MaxSignup}}{{else}} / 不限{{end}}</td>
          <td data-label="签到">
            <span class="pill{{if not .SigninEnabled}} pill-muted{{end}}">{{if .SigninEnabled}}开启{{else}}关闭{{end}}</span>
            <div class="muted">已签到 {{.CheckedInCount}} / 报名 {{.SignupCount}}</div>
          </td>
          <td data-label="分组/一对一">
            {{if .GroupEnabled}}<span class="pill">分组</span>{{end}}
            {{if .GroupStatus}}<span class="muted">{{.GroupStatus}}</span>{{end}}
            {{if .OnetooneEnabled}}<span class="pill">一对一</span>{{end}}
            {{if .OnetooneStatus}}<span class="muted">{{.OnetooneStatus}}</span>{{end}}
            {{if and (not .GroupEnabled) (not .OnetooneEnabled)}}<span class="muted">—</span>{{end}}
          </td>
          <td data-label="操作">
            <div class="admin-actions">
              <a class="button primary small" href="/admin/activities/{{.ID}}">工作台</a>
              <a class="button small" href="/admin/activities/{{.ID}}/edit">编辑</a>
            </div>
          </td>
        </tr>
      {{end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <div class="empty-state admin-empty">
    <h2>还没有活动</h2>
    <p class="shell-empty-text">创建第一个活动后，就能在工作台管理报名、签到、海报与广播。</p>
    <a class="button primary" href="/admin/activities/new">新建活动</a>
  </div>
  {{end}}
</section>
{{end}}
