{{define "content"}}
<section class="card">
  <p class="eyebrow">账号安全</p>
  <h1>修改密码</h1>
  {{template "flash" .}}
  {{if .Data.Required}}
  <p class="alert alert-warn">你目前使用临时密码或管理员刚重置密码，必须先设定新密码才能继续使用。</p>
  {{end}}
  <form method="post" action="/password" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <label for="current-password">目前密码</label>
    <input id="current-password" name="current_password" type="password"
           autocomplete="current-password" required>
    <label for="new-password">新密码</label>
    <input id="new-password" name="password" type="password"
           autocomplete="new-password" minlength="8" maxlength="128" required>
    <label for="new-password-confirm">再次输入新密码</label>
    <input id="new-password-confirm" name="password_confirm" type="password"
           autocomplete="new-password" minlength="8" maxlength="128" required>
    <p class="hint">至少 8 个字元；不要使用临时密码。</p>
    <button type="submit" class="button primary">更新密码</button>
  </form>
</section>
{{end}}
