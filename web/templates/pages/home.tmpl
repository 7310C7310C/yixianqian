{{define "content"}}
<section class="welcome-hero home-hero">
  <div class="home-hero-mark" aria-hidden="true">💕</div>
  <h1 class="welcome-title">YIXIANQIAN</h1>
  <p class="welcome-lead">A trusted place for single Christians to meet.<br>Real profiles, human review, and meaningful connections.</p>
  <div class="welcome-actions">
    <a class="button primary block" href="/register?from=home">Create account</a>
    <a class="button block" href="/login">Log in</a>
  </div>
  <p class="welcome-note">Free to join · Human review · Phone number login</p>
</section>

<section class="welcome-features" aria-label="Why YIXIANQIAN">
  <article class="welcome-feature">
    <div class="home-feature-icon" aria-hidden="true">🛡️</div>
    <h2>Human review</h2>
    <p>Every profile is reviewed by a real person to keep fakes out.</p>
  </article>
  <article class="welcome-feature">
    <div class="home-feature-icon" aria-hidden="true">💌</div>
    <h2>Anonymous likes</h2>
    <p>Send a like anonymously. A mutual like connects you automatically.</p>
  </article>
  <article class="welcome-feature">
    <div class="home-feature-icon" aria-hidden="true">🔔</div>
    <h2>Activity updates</h2>
    <p>Get notified when someone you like signs up for an activity.</p>
  </article>
</section>

<section class="home-feishu" id="feishu">
  <h2>Used the Feishu version before?</h2>
  <p class="home-feishu-lead">If you already registered on Feishu, set your password there first, then sign in here with your phone number and password. No need to register again.</p>
  <ol class="home-steps">
    <li>Open the Feishu version of YIXIANQIAN using the link below.</li>
    <li>Set your login password there.</li>
    <li>Come back to this page and sign in with your phone number and password.</li>
  </ol>
  <a class="button block home-feishu-link" href="{{.FeishuURL}}" target="_blank" rel="noopener noreferrer">Open the Feishu version ↗</a>
</section>

<div class="welcome-footer-note">
  <p>YIXIANQIAN · Meet the right person</p>
</div>
{{end}}
