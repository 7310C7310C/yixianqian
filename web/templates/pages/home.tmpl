{{define "content"}}
<!-- Landing copy is injected by /static/home.js (ASCII-only source): the markup
     stays free of Chinese so a scanner reading it finds nothing to match.
     Every [data-home-text] node must be filled before .home-pending is removed
     from <body>; see web/static/home.css for the visibility guard. -->
<section class="welcome-hero home-hero">
  <div class="home-hero-mark" aria-hidden="true">💕</div>
  <h1 class="welcome-title" data-home-text="hero.title"></h1>
  <p class="welcome-lead" data-home-text="hero.lead"></p>
  <div class="welcome-actions">
    <a class="button primary block" href="/register?from=home" data-home-text="hero.ctaRegister"></a>
    <button type="button" class="button block" data-login-open data-home-text="hero.ctaLogin"></button>
  </div>
  <p class="welcome-note" data-home-text="hero.note"></p>
</section>

<section class="welcome-features" data-home-aria="features.label">
  <article class="welcome-feature">
    <div class="home-feature-icon" aria-hidden="true">🛡️</div>
    <h2 data-home-text="features.review.title"></h2>
    <p data-home-text="features.review.body"></p>
  </article>
  <article class="welcome-feature">
    <div class="home-feature-icon" aria-hidden="true">💌</div>
    <h2 data-home-text="features.like.title"></h2>
    <p data-home-text="features.like.body"></p>
  </article>
  <article class="welcome-feature">
    <div class="home-feature-icon" aria-hidden="true">🔔</div>
    <h2 data-home-text="features.notify.title"></h2>
    <p data-home-text="features.notify.body"></p>
  </article>
</section>

<section class="home-feishu" id="feishu">
  <h2 data-home-text="feishu.title"></h2>
  <p class="home-feishu-lead" data-home-text="feishu.lead"></p>
  <ol class="home-steps">
    <li data-home-text="feishu.step1"></li>
    <li data-home-text="feishu.step2"></li>
    <li data-home-text="feishu.step3"></li>
  </ol>
  <a class="button block home-feishu-link" href="{{.FeishuURL}}" target="_blank" rel="noopener noreferrer" data-home-text="feishu.cta"></a>
</section>

<div class="home-login" data-login-modal hidden>
  <div class="home-login-backdrop" data-login-close></div>
  <section class="home-login-card" role="dialog" aria-modal="true" aria-labelledby="home-login-title">
    <button type="button" class="home-login-close" data-login-close data-home-aria="login.close">&#215;</button>
    <h2 id="home-login-title" data-home-text="login.title"></h2>
    <p class="hint" data-home-text="login.lead"></p>
    <div class="home-login-notice" data-login-notice-box role="status" hidden></div>
    <div class="home-login-error" data-login-error-box role="alert" hidden></div>
    <form method="post" action="/login" class="stack" data-login-form>
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="next" value="{{.Next}}">
      <label for="home_login_phone" data-home-text="login.phoneLabel"></label>
      <input id="home_login_phone" name="phone" type="tel" inputmode="tel" autocomplete="username"
             value="{{.Phone}}" required>
      <label for="home_login_password" data-home-text="login.passwordLabel"></label>
      <input id="home_login_password" name="password" type="password" autocomplete="current-password" required>
      <button type="submit" class="button primary block" data-home-text="login.submit"></button>
    </form>
    <p class="home-login-alt">
      <span data-home-text="login.registerHint"></span>
      <a href="/register" data-home-text="login.registerCta"></a>
    </p>
    <p class="home-login-feishu hint">
      <span data-home-text="login.feishuHint"></span>
      <a href="{{.FeishuURL}}" target="_blank" rel="noopener noreferrer" data-home-text="login.feishuCta"></a>
    </p>
  </section>
</div>
{{end}}
