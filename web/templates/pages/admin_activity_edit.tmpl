{{define "content"}}
{{template "admin_nav" .}}

<section class="card">
  <p class="eyebrow">活动</p>
  <h1>{{if .Data.IsNew}}新建活动{{else}}编辑活动{{end}}</h1>
  {{template "flash" .}}
  {{if .Data.Error}}<div class="alert alert-error" role="alert">{{.Data.Error}}</div>{{end}}
  <form method="post" action="{{if .Data.IsNew}}/admin/activities{{else}}/admin/activities/{{.Data.Activity.ID}}{{end}}" enctype="multipart/form-data" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <label>活动名称<input type="text" name="name" required maxlength="100" value="{{.Data.Activity.Name}}"></label>
    {{if .Data.Activity.PosterMediaID}}
    <div class="admin-poster">
      <img src="/admin/activities/{{.Data.Activity.ID}}/poster?size=thumb" alt="{{.Data.Activity.Name}} 海报">
    </div>
    <p class="hint">当前海报：{{.Data.PosterName}}</p>
    {{end}}
    <label>活动海报（可选）<input type="file" name="poster" accept="image/jpeg,image/png"></label>
    <p class="hint">可选，只接受 JPEG/PNG，最大 {{.MediaMaxMB}} MB；{{if .Data.IsNew}}不选择则不上传海报{{else}}不选择则保留当前海报{{end}}。</p>
    <label>活动描述<textarea name="description" rows="4" maxlength="2000">{{.Data.Activity.Description}}</textarea></label>
    <label>地点<input type="text" name="location" maxlength="200" value="{{.Data.Activity.Location}}"></label>
    <label>参加条件<input type="text" name="condition" maxlength="500" value="{{.Data.Activity.Condition}}"></label>
    <div class="filter-range">
      <label>报名上限（0=不限）<input type="number" name="max_signup" min="0" value="{{.Data.Activity.MaxSignup}}"></label>
      <label>费用<input type="text" name="fee" maxlength="100" value="{{.Data.Activity.Fee}}"></label>
    </div>
    <label>食宿<input type="text" name="food" maxlength="200" value="{{.Data.Activity.Food}}"></label>
    <label>状态
      <select name="status">
        {{if .Data.StatusKeep}}<option value="{{.Data.StatusUnknown}}" selected>保持目前状态{{if .Data.StatusUnknown}}（{{.Data.StatusUnknown}}）{{else}}（未设置）{{end}}</option>{{end}}
        {{$current := .Data.Activity.Status}}
        {{range .Data.Statuses}}<option value="{{.}}"{{if eq . $current}} selected{{end}}>{{.}}</option>{{end}}
      </select>
    </label>
    <div class="filter-range three">
      <label>发布时间<input type="datetime-local" name="publish_at" value="{{if .Data.Activity.PublishAt}}{{.Data.Activity.PublishAt.Format "2006-01-02T15:04"}}{{end}}"></label>
      <label>开始时间<input type="datetime-local" name="start_at" value="{{if .Data.Activity.StartAt}}{{.Data.Activity.StartAt.Format "2006-01-02T15:04"}}{{end}}"></label>
      <label>结束时间<input type="datetime-local" name="end_at" value="{{if .Data.Activity.EndAt}}{{.Data.Activity.EndAt.Format "2006-01-02T15:04"}}{{end}}"></label>
    </div>
    <fieldset>
      <legend>分组/一对一/签到</legend>
      <label class="admin-check"><input type="checkbox" name="group_enabled" value="1"{{if .Data.Activity.GroupEnabled}} checked{{end}}> 开启分组</label>
      <div class="filter-range">
        <label>每组男生<input type="number" name="male_per_group" min="0" value="{{.Data.Activity.MalePerGroup}}"></label>
        <label>每组女生<input type="number" name="female_per_group" min="0" value="{{.Data.Activity.FemalePerGroup}}"></label>
      </div>
      <label class="admin-check"><input type="checkbox" name="onetoone_enabled" value="1"{{if .Data.Activity.OnetooneEnabled}} checked{{end}}> 开启一对一</label>
      <label class="admin-check"><input type="checkbox" name="signin_enabled" value="1"{{if .Data.Activity.SigninEnabled}} checked{{end}}> 开启现场签到</label>
      <label>4 位签到码<input type="text" name="signin_code" maxlength="4" inputmode="numeric" value="{{.Data.Activity.SigninCode}}" placeholder="例如 0123"></label>
    </fieldset>
    {{if not .Data.IsNew}}<p class="hint">当前报名人数：{{.Data.Activity.CurrentSignup}}（由报名流程维护，不在此修改）</p>{{end}}
    <div class="admin-actions">
      <button type="submit" class="button primary">{{if .Data.IsNew}}创建活动{{else}}保存修改{{end}}</button>
      {{if not .Data.IsNew}}<a class="button" href="/admin/activities/{{.Data.Activity.ID}}">返回工作台</a>{{end}}
      <a class="button" href="/admin/activities">取消</a>
    </div>
  </form>
</section>
{{end}}
