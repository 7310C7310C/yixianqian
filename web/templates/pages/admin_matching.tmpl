{{define "content"}}
{{template "admin_nav" .}}

<section class="admin-page-head">
  <div class="admin-page-head-main">
    <p class="admin-eyebrow">匹配</p>
    <h1 class="admin-page-title">匹配控制台</h1>
    <p class="admin-subtitle">分组与一对一互斥，同一活动只能开启一种模式。执行、重置与结果都以活动为单位。</p>
  </div>
  <div class="admin-page-actions">
    <a class="button" href="/admin/activities">活动管理</a>
  </div>
</section>

{{template "flash" .}}

<section class="admin-stats-inline" aria-label="匹配规则">
  <div class="admin-stats-inline-item">
    <span>活动</span>
    <strong>{{len .Data.Rows}} 个</strong>
  </div>
  <div class="admin-stats-inline-item">
    <span>模式规则</span>
    <strong>互斥</strong>
  </div>
  <div class="admin-stats-inline-item">
    <span>参与条件</span>
    <strong>签到优先</strong>
  </div>
  <div class="admin-stats-inline-item">
    <span>结果</span>
    <strong>按轮次保存</strong>
  </div>
</section>

<section class="admin-section">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">活动匹配清单</h2>
      <p class="admin-section-desc">先看执行预览，再执行分组或一对一；双开的活动需要先在工作台关闭一个模式。</p>
    </div>
    <span class="admin-section-meta">{{len .Data.Rows}} 个活动</span>
  </div>

  {{if .Data.Rows}}
  <div class="admin-record-list">
    {{range .Data.Rows}}
    <article class="admin-record">
      <span class="admin-avatar" aria-hidden="true">{{template "admin_icon_matching"}}</span>
      <div class="admin-record-main">
        <h3 class="admin-record-title">
          {{.Activity.Name}}
          {{if eq .Mode "双开"}}<span class="admin-chip admin-chip--cancel">双开</span>
          {{else if eq .Mode "分组"}}<span class="admin-chip admin-chip--open">分组</span>
          {{else if eq .Mode "一对一"}}<span class="admin-chip admin-chip--full">一对一</span>
          {{else}}<span class="admin-chip admin-chip--muted">未开启</span>{{end}}
          <span class="admin-chip admin-chip--muted">{{.Activity.Status}}</span>
        </h3>
        <p class="admin-record-sub">
          <code>{{.Activity.ActivityNo}}</code>
          · 报名 <strong>{{.SignupCount}}</strong> / 签到 <strong>{{.CheckedInCount}}</strong>
        </p>
        <div class="admin-record-meta">
          <span class="admin-chip {{if .Activity.GroupEnabled}}admin-chip--open{{else}}admin-chip--muted{{end}}">
            分组{{if .Activity.GroupEnabled}}已开启{{else}}未开启{{end}}{{if .Activity.GroupStatus}} · {{.Activity.GroupStatus}}{{end}}{{if gt .GroupRound 0}} · 第 {{.GroupRound}} 轮{{end}}
          </span>
          <span class="admin-chip {{if .Activity.OnetooneEnabled}}admin-chip--full{{else}}admin-chip--muted{{end}}">
            一对一{{if .Activity.OnetooneEnabled}}已开启{{else}}未开启{{end}}{{if .Activity.OnetooneStatus}} · {{.Activity.OnetooneStatus}}{{end}}{{if gt .OnetooneRound 0}} · 第 {{.OnetooneRound}} 轮{{end}}
          </span>
        </div>
        {{if eq .Mode "双开"}}
        <p class="admin-alert admin-alert--warn">双开时执行会失败，请先在活动工作台关闭一个模式。</p>
        {{end}}
      </div>
      <div class="admin-record-actions">
        {{if .Activity.GroupEnabled}}<a class="button small primary" href="/admin/matching/group/{{.Activity.ID}}">分组控制台</a>{{end}}
        {{if .Activity.OnetooneEnabled}}<a class="button small primary" href="/admin/matching/onetoone/{{.Activity.ID}}">一对一控制台</a>{{end}}
        <a class="button small" href="/admin/activities/{{.Activity.ID}}">活动工作台</a>
      </div>
    </article>
    {{end}}
  </div>
  {{else}}
  <div class="admin-empty">
    <span class="admin-empty-icon" aria-hidden="true">{{template "admin_icon_matching"}}</span>
    <h2 class="admin-empty-title">还没有活动</h2>
    <p>先创建活动，再在活动工作台开启分组或一对一。</p>
    <a class="button primary" href="/admin/activities/new">新建活动</a>
  </div>
  {{end}}
</section>

<section class="admin-section" id="recommend">
  <div class="admin-section-head">
    <div class="admin-section-head-main">
      <h2 class="admin-section-title">本周推荐位</h2>
      <p class="admin-section-desc">每周一换批：保留 4 个、其余换新；匿名喜欢你的人必显且排最前。必显原因只存服务端，本页与用户接口都不展示谁暗恋谁。</p>
    </div>
    <span class="admin-section-meta">{{.Data.Recommend.Week}}</span>
  </div>

  <div class="admin-stats-inline" aria-label="本周推荐概况">
    <div class="admin-stats-inline-item">
      <span>覆盖用户</span>
      <strong>{{.Data.Recommend.Viewers}} 人</strong>
    </div>
    <div class="admin-stats-inline-item">
      <span>推荐条目</span>
      <strong>{{.Data.Recommend.Entries}} 条</strong>
    </div>
    <div class="admin-stats-inline-item">
      <span>生成时间</span>
      <strong>{{if .Data.Recommend.Pending}}尚未生成{{else}}{{.Data.Recommend.Generated}}{{end}}</strong>
    </div>
  </div>

  <form method="post" action="/admin/matching/recommend/run" class="admin-matching-form">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <div class="admin-form-actions">
      <button type="submit" class="button primary">重新生成本周名单</button>
      <span class="hint">同一周重跑只剔除失效并补空位，不会打乱本周名单；跨周才换批。</span>
    </div>
  </form>

  {{if .Data.Recommend.Rows}}
  <div class="admin-record-list">
    {{range .Data.Recommend.Rows}}
    <article class="admin-record">
      <span class="admin-avatar" aria-hidden="true">{{template "admin_icon_users"}}</span>
      <div class="admin-record-main">
        <h3 class="admin-record-title">{{if .Nickname}}{{.Nickname}}{{else}}用户 {{.UserID}}{{end}}</h3>
        <p class="admin-record-sub">本周推荐位 <strong>{{.Count}}</strong> 个 · 更新于 {{.Updated}}</p>
      </div>
    </article>
    {{end}}
  </div>
  <p class="hint">仅列出最近更新的 20 人；必显原因不对外展示。</p>
  {{else}}
  <p class="admin-alert admin-alert--warn">本周还没有名单。可点击「重新生成本周名单」，或等待整点任务自动补跑。</p>
  {{end}}
</section>
{{end}}
