{{define "content"}}
{{template "admin_nav" .}}

<section class="card">
  <div class="admin-title-row">
    <div>
      <p class="eyebrow">匹配</p>
      <h1>匹配控制台</h1>
      <p class="hint">分组与一对一互斥，同一活动只能开启一种模式。执行、重置与结果都以活动为单位。</p>
    </div>
    <div class="admin-actions">
      <a class="button" href="/admin/activities">活动管理</a>
    </div>
  </div>
  {{template "flash" .}}
</section>

<section class="card">
  <h2>活动匹配清单</h2>
  {{if .Data.Rows}}
  <div class="admin-table-wrap">
    <table class="admin-table admin-matching-table">
      <thead>
        <tr>
          <th scope="col">活动</th>
          <th scope="col">模式</th>
          <th scope="col">分组</th>
          <th scope="col">一对一</th>
          <th scope="col">报名 / 签到</th>
          <th scope="col">控制台</th>
        </tr>
      </thead>
      <tbody>
      {{range .Data.Rows}}
        <tr>
          <td data-label="活动">
            <strong>{{.Activity.Name}}</strong>
            <div class="muted"><code>{{.Activity.ActivityNo}}</code></div>
          </td>
          <td data-label="模式">
            {{if eq .Mode "双开"}}<span class="pill pill-warn">双开</span>
            {{else if eq .Mode "分组"}}<span class="pill">分组</span>
            {{else if eq .Mode "一对一"}}<span class="pill">一对一</span>
            {{else}}<span class="pill pill-muted">未开启</span>{{end}}
            {{if eq .Mode "双开"}}<div class="muted">双开时执行会失败，请先在活动工作台关闭一个模式。</div>{{end}}
          </td>
          <td data-label="分组">
            {{if .Activity.GroupEnabled}}
              <span class="pill">已开启</span>
              {{if .Activity.GroupStatus}}<div class="muted">状态：{{.Activity.GroupStatus}}</div>{{end}}
              {{if gt .GroupRound 0}}<div class="muted">当前第 {{.GroupRound}} 轮</div>{{else}}<div class="muted">尚无结果</div>{{end}}
            {{else}}<span class="pill pill-muted">未开启</span>{{end}}
          </td>
          <td data-label="一对一">
            {{if .Activity.OnetooneEnabled}}
              <span class="pill">已开启</span>
              {{if .Activity.OnetooneStatus}}<div class="muted">状态：{{.Activity.OnetooneStatus}}</div>{{end}}
              {{if gt .OnetooneRound 0}}<div class="muted">最新第 {{.OnetooneRound}} 轮</div>{{else}}<div class="muted">尚无结果</div>{{end}}
            {{else}}<span class="pill pill-muted">未开启</span>{{end}}
          </td>
          <td data-label="报名 / 签到">
            <strong>{{.SignupCount}}</strong> / {{.CheckedInCount}}
            <div class="muted">签到后只有已签到者参与匹配</div>
          </td>
          <td data-label="控制台">
            <div class="admin-actions">
              {{if .Activity.GroupEnabled}}<a class="button small" href="/admin/matching/group/{{.Activity.ID}}">分组控制台</a>{{end}}
              {{if .Activity.OnetooneEnabled}}<a class="button small" href="/admin/matching/onetoone/{{.Activity.ID}}">一对一控制台</a>{{end}}
              <a class="button small" href="/admin/activities/{{.Activity.ID}}">活动工作台</a>
            </div>
          </td>
        </tr>
      {{end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <div class="empty-state admin-empty">
    <h2>还没有活动</h2>
    <p class="shell-empty-text">先创建活动，再在活动工作台开启分组或一对一。</p>
    <a class="button primary" href="/admin/activities/new">新建活动</a>
  </div>
  {{end}}
</section>
{{end}}
