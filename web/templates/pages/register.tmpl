{{define "content"}}
<section class="register-hero">
  <p class="eyebrow" data-register-text="hero.eyebrow"></p>
  <h1 data-register-text="hero.title"></h1>
  <p class="muted" data-register-text="hero.lead"></p>
  <p class="hint"><span data-register-text="hero.loginHint"></span><a href="/login" data-register-text="hero.loginCta"></a><span data-register-text="hero.loginHintEnd"></span></p>
</section>

{{if .Error}}<div class="alert alert-error" role="alert" data-register-error></div>{{end}}

<form method="post" action="/register" enctype="multipart/form-data" class="register-form" id="register-form">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

  <section class="card register-section">
    <h2 data-register-text="photos.title"></h2>
    <p class="hint" data-register-text="photos.hint"></p>
    <p class="hint" data-register-text="photos.heic"></p>
    <div class="register-field">
      <label for="f_photos"><span data-register-text="photos.label"></span><span class="req" aria-hidden="true">*</span></label>
      <input id="f_photos" name="photos" type="file" accept="image/jpeg,image/png" multiple required>
      <p class="hint" data-register-text="photos.retry"></p>
    </div>
  </section>

  <section class="card register-section">
    <h2 data-register-text="password.title"></h2>
    <p class="hint" data-register-text="password.hint"></p>
    <div class="register-field">
      <label for="f_password"><span data-register-text="password.label"></span><span class="req" aria-hidden="true">*</span></label>
      <input id="f_password" name="password" type="password" autocomplete="new-password"
             minlength="8" maxlength="128" required>
    </div>
    <div class="register-field">
      <label for="f_password_confirm"><span data-register-text="password.confirmLabel"></span><span class="req" aria-hidden="true">*</span></label>
      <input id="f_password_confirm" name="password_confirm" type="password"
             autocomplete="new-password" minlength="8" maxlength="128" required>
      <p class="hint" data-register-text="password.hint2"></p>
    </div>
  </section>

  {{range $i, $section := .Data.Sections}}
  <section class="card register-section">
    <h2 data-register-text="section.{{$i}}.title"></h2>
    {{range .Fields}}{{template "register_field" .}}{{end}}
  </section>
  {{end}}

  <section class="card register-submit">
    <p class="hint" data-register-text="submit.hint"></p>
    <button type="submit" class="button primary block" data-register-text="submit.button"></button>
    <p class="register-alt"><span data-register-text="submit.altHint"></span><a href="/login" data-register-text="submit.altCta"></a></p>
  </section>
</form>
{{end}}
