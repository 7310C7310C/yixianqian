{{define "content"}}
<section class="card narrow">
  <h1 data-copy-text="login.title"></h1>
  <p class="muted" data-copy-text="login.lead"></p>
  {{if .Error}}<div class="alert alert-error" role="alert">{{.Error}}</div>{{end}}
  {{if .NoticeCopyKey}}<div class="alert alert-ok" role="status" data-copy-text="{{.NoticeCopyKey}}"></div>{{end}}
  <form method="post" action="/login" class="stack">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <input type="hidden" name="next" value="{{.Next}}">
    <label for="phone" data-copy-text="login.phoneLabel"></label>
    <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="username"
           value="{{.Phone}}" required autofocus>
    <label for="password" data-copy-text="login.passwordLabel"></label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <button type="submit" class="button primary" data-copy-text="login.submit"></button>
  </form>
  <div class="auth-alt">
    <p class="hint" data-copy-text="login.altHint"></p>
    <a class="button primary block" href="/register" data-copy-text="login.altCta"></a>
  </div>
  <div class="auth-feishu">
    <p><strong data-copy-text="login.feishuTitle"></strong></p>
    <p class="hint"><span data-copy-text="login.feishuLead"></span><a href="{{.FeishuURL}}" target="_blank" rel="noopener noreferrer" data-copy-text="login.feishuCta"></a></p>
  </div>
  <p class="hint" data-copy-text="login.firstHint"></p>
</section>
{{end}}
