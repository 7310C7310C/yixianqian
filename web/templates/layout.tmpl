{{define "layout"}}
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#ff6b81">
  <title>{{if .PublicLanding}}{{.Title}}{{else}}{{.Title}} · 一线牵{{end}}</title>
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  {{if .PublicLanding}}
  <!-- Public landing: dedicated ASCII-only stylesheet (no app.css/shell.css,
       whose comments contain Chinese); the copy itself comes from home.js. -->
  <link rel="stylesheet" href="/static/home.css?v={{assetVersion}}">
  {{else if .ScanSafe}}
  <!-- Scan-safe anonymous pages: same ASCII-only base as the landing page plus
       auth form styles; every copy string is injected by public-copy.js. -->
  <link rel="stylesheet" href="/static/home.css?v={{assetVersion}}">
  <link rel="stylesheet" href="/static/auth.css?v={{assetVersion}}">
  {{else}}
  <link rel="stylesheet" href="/static/app.css?v={{assetVersion}}">
  <link rel="stylesheet" href="/static/shell.css?v={{assetVersion}}">
  {{end}}
  {{if .PageCSS}}<link rel="stylesheet" href="/static/{{.PageCSS}}?v={{assetVersion}}">{{end}}
</head>
<body class="shell-body{{if .ActiveNav}} admin-shell{{end}}{{if .PublicLanding}} public-landing home-pending{{end}}{{if .ScanSafe}} scan-safe copy-pending{{end}}"{{if .CopyPage}} data-copy-page="{{.CopyPage}}"{{end}}{{if .ErrorCode}} data-error-code="{{.ErrorCode}}"{{end}}{{if .CopyJSON}} data-copy-json="{{.CopyJSON}}"{{end}}>
  {{if and (not .PublicLanding) (not .ScanSafe)}}<a class="shell-skip" href="#main">跳至主要内容</a>

  <header class="shell-header">
    <div class="shell-header-inner">
      <a class="shell-brand" href="/" aria-label="一线牵">
        <svg class="shell-brand-mark" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        <span class="shell-brand-text">一线牵</span>
      </a>
      {{if .User}}
      <nav class="shell-account" aria-label="账号">
        <span class="shell-who" title="{{.User.Name}}">{{.User.Name}}</span>
        <form method="post" action="/logout" class="shell-logout-form">
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          <button type="submit" class="shell-logout">退出登录</button>
        </form>
      </nav>
      {{end}}
    </div>
  </header>
  {{end}}

  <main id="main" class="shell-main" tabindex="-1">
    <div class="shell-container">
      {{template "content" .}}
    </div>
  </main>
  {{if .ActiveNav}}<script src="/static/admin.js?v={{assetVersion}}" defer></script>{{end}}
  {{if .PublicLanding}}<script src="/static/home.js?v={{assetVersion}}" defer></script>{{end}}
  {{if .CopyJSON}}<script src="/static/register.js?v={{assetVersion}}" defer></script>{{end}}
  {{if .CopyPage}}<script src="/static/public-copy.js?v={{assetVersion}}" defer></script>{{end}}
</body>
</html>
{{end}}
