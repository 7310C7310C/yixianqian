[Unit]
Description=Yixianqian Next (Go, staging)
After=network.target postgresql.service
Wants=postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=yxq
Group=yxq
WorkingDirectory=/opt/yixianqian-next
EnvironmentFile=/opt/yixianqian-next/config/staging.env
Environment=GOMAXPROCS=2
ExecStart=/opt/yixianqian-next/bin/server
Restart=always
RestartSec=3
LimitNOFILE=8192
NoNewPrivileges=true
PrivateTmp=true
TemporaryFileSystem=/tmp:size=256M,mode=1777
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/yixianqian-next/cache /opt/yixianqian-next/bin
MemoryMax=768M

[Install]
WantedBy=multi-user.target
