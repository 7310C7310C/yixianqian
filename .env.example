# Copy to .env and fill in. Never commit .env.
# This file is parsed by your shell/tooling; the app only reads process env.

APP_ENV=development
HTTP_ADDR=:8080
# Public origin used for activation links and cookie decisions.
BASE_URL=http://localhost:8080

DATABASE_URL=postgres://yixianqian:yixianqian@localhost:5432/yixianqian?sslmode=disable

# At least 32 random bytes. Generate with: openssl rand -base64 48
SESSION_SECRET=dev-only-change-me-0123456789abcdef
# Optional. If empty, derived from SESSION_SECRET. Set a separate value in production.
CSRF_SECRET=

SESSION_COOKIE_NAME=yxq_session
# Set false only for plain-HTTP local development.
SESSION_COOKIE_SECURE=false
SESSION_TTL=720h

# Reverse proxy that is allowed to supply X-Real-IP / X-Forwarded-For.
# app 直接 peer 是本机 nginx；只有 app 直接看到 server2 时才用 45.125.16.205。
# Comma-separated IPs or CIDRs. Go config fallback is 45.125.16.205; this example uses local nginx.
TRUSTED_PROXY=127.0.0.1

AUTO_MIGRATE=true
# Show the signup roster to logged-in users (v1 behaviour). Set false for count-only.
ACTIVITY_ROSTER_ENABLED=true

# Cloudflare R2 (S3-compatible). Endpoint may include https://.
R2_ENDPOINT=https://example-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yixianqian-media
# "auto" is the correct value for R2. Leave R2_SECURE unset to infer from the endpoint scheme.
R2_REGION=auto
# R2_SECURE=true

MEDIA_MAX_BYTES=10485760
MEDIA_THUMB_SIZE=512
MEDIA_MAX_PIXELS=12500000
MEDIA_MAX_DIMENSION=8000
MAX_CONCURRENT_HASHES=2
MAX_CONCURRENT_MEDIA=1

# 本地人脸检测（可选；生产/staging 指向独立 venv 与 tools/face_probe.py）。
# FACE_PROBE_CMD 是空格分隔的命令前缀，图片路径追加在最后。
FACE_PROBE_CMD=python3 tools/face_probe.py

# 缩略图磁盘缓存（批次8）：MEDIA_CACHE_DIR 为空=关闭（默认）。部署值见
# docs/runbooks/staging.md（/var/cache/yxq/thumbs，需存在且属主 yxq）。
MEDIA_CACHE_DIR=/opt/yixianqian-next/cache/thumbs
MEDIA_CACHE_BYTES=268435456

# 批次9：home/cards 成功响应的进程内短缓存（秒/条数；0=关闭）。
READ_CACHE_TTL=10s
READ_CACHE_ITEMS=1024
READ_CACHE_BYTES=33554432
FACE_PROBE_TIMEOUT=8s
# FACE_MODEL_PATH 仅工具/子进程专用：face_probe.py 直接读取，Go config 不解析。
# FACE_MODEL_PATH=/opt/yixianqian-next/tools/face_detection_yunet.onnx

ACTIVATION_TTL=24h

LOG_LEVEL=info
LOG_FORMAT=json
